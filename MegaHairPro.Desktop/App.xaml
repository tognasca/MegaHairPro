<Application x:Class="MegaHairPro.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MegaHairPro.Desktop.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Colors.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ===================== Tipografia ===================== -->
            <FontFamily x:Key="AppFont">Segoe UI</FontFamily>

            <!-- ===================== Conversores ===================== -->
            <local:StringToBrushConverter x:Key="StringToBrush"/>
            <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <local:InverseBoolToVisibilityConverter x:Key="BoolToVisInv"/>
            <local:HasTextToVisibilityConverter x:Key="HasText"/>
            <local:CategoriaIconeConverter x:Key="CatIcone"/>
            <local:CategoriaFundoConverter x:Key="CatFundo"/>
            <local:PagamentoIconeConverter x:Key="PagIcone"/>
            <local:PagamentoDescricaoConverter x:Key="PagDesc"/>
            <local:StringEqualsConverter x:Key="StrEq"/>
            <local:FirstCharConverter x:Key="FirstChar"/>

            <!-- ===================== Cantos padrão ===================== -->
            <CornerRadius x:Key="ButtonRadius">10</CornerRadius>
            <CornerRadius x:Key="CardRadius">16</CornerRadius>

            <!--
                ===================== Card genérico =====================
                IMPORTANTE: o DropShadowEffect foi removido daqui de propósito.
                Qualquer Effect (DropShadow, Blur etc.) aplicado a um Border que
                contém TextBlock força o WPF a renderizar tudo numa superfície
                intermediária (bitmap) e DESLIGA o ClearType — é isso que deixava
                as letras "ofuscadas e distorcidas". A sombra agora é um Border
                separado, atrás do card, sem nenhum texto dentro dele
                (ver MainWindow.xaml, uso do style "CardShadow").
            -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Surface}"/>
                <Setter Property="CornerRadius" Value="{StaticResource CardRadius}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <!-- Border decorativo que fica ATRÁS do Card, só com a sombra (sem texto) -->
            <Style x:Key="CardShadow" TargetType="Border">
                <Setter Property="CornerRadius" Value="{StaticResource CardRadius}"/>
                <Setter Property="Background" Value="#6E2142"/>
                <Setter Property="Opacity" Value="0.08"/>
                <Setter Property="Margin" Value="0,5,-3,-5"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <BlurEffect Radius="16"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===================== Card de KPI ===================== -->
            <Style x:Key="KpiCard" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Padding" Value="16,14"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
            </Style>

            <!-- ===================== Botão base ===================== -->
            <Style x:Key="BaseBtn" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource ButtonRadius}"
                                    Padding="{TemplateBinding Padding}"
                                    Opacity="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Primário — Vinho sólido -->
            <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
                <Setter Property="Background" Value="{StaticResource Wine}"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>

            <!-- Dourado — para ações de destaque -->
            <Style x:Key="GoldBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
                <Setter Property="Background" Value="{StaticResource Gold}"/>
                <Setter Property="Foreground" Value="#3F2E0A"/>
            </Style>

            <!-- Contorno — Vinho, fundo transparente -->
            <Style x:Key="OutlineBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource Wine}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Wine}"/>
                <Setter Property="BorderThickness" Value="1.4"/>
            </Style>

            <!-- Fantasma — sem fundo, usado em ícones e navegação -->
            <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                <Setter Property="FontWeight" Value="Normal"/>
            </Style>

            <!-- Sucesso — Verde terroso -->
            <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
                <Setter Property="Background" Value="{StaticResource Success}"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>

            <!-- Perigo — Vermelho terroso -->
            <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
                <Setter Property="Background" Value="{StaticResource Danger}"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>

            <!-- Terracota — acento secundário, para ações intermediárias -->
            <Style x:Key="TerracottaBtn" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
                <Setter Property="Background" Value="{StaticResource Terracotta}"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>

            <!-- ===================== TextBox padrão ===================== -->
            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Background" Value="{StaticResource Surface}"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource Wine}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===================== ComboBox padrão ===================== -->
            <Style TargetType="ComboBox">
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Background" Value="{StaticResource Surface}"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

            <!-- ===================== DataGrid padrão ===================== -->
            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="{StaticResource Surface}"/>
                <Setter Property="RowBackground" Value="{StaticResource Surface}"/>
                <Setter Property="AlternatingRowBackground" Value="{StaticResource CreamSoft}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Line}"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="FontSize" Value="12.5"/>
            </Style>
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{StaticResource WineLight}"/>
                <Setter Property="Foreground" Value="{StaticResource Wine}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>

            <!-- ===================== Cartão de escolha (serviço / pagamento) ===================== -->
            <Style x:Key="ChoiceTile" TargetType="RadioButton">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Margin" Value="0,0,8,8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd"
                                    Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource Line}"
                                    BorderThickness="1.5"
                                    CornerRadius="14"
                                    Padding="12,10"
                                    MinWidth="118" MinHeight="76"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource WineLight}"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Wine}"/>
                                    <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FBF3F5"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Gold}"/>
                                    <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ChoiceTileToggle" TargetType="ToggleButton">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Margin" Value="0,0,8,8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="bd"
                                    Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource Line}"
                                    BorderThickness="1.5"
                                    CornerRadius="14"
                                    Padding="12,10"
                                    MinWidth="148" MinHeight="88"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource WineLight}"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Wine}"/>
                                    <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FBF3F5"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Gold}"/>
                                    <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===================== Separator padrão ===================== -->
            <Style TargetType="Separator">
                <Setter Property="Background" Value="{StaticResource Line}"/>
                <Setter Property="Height" Value="1"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
