<Window x:Class="MegaHairPro.Desktop.ClienteRapidoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova cliente" Height="611" Width="566"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Cream}"
        FontFamily="{StaticResource AppFont}"
        Foreground="{StaticResource Ink}">
    <Border Margin="18" Style="{StaticResource Card}" Padding="22">
        <StackPanel>
            <TextBlock Text="Cadastro rápido" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Só o essencial para iniciar o atendimento. O restante pode ser completado depois."
                       TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,4,0,16"/>

            <TextBlock Text="Nome" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtNome"/>

            <TextBlock Text="Telefone" FontWeight="SemiBold" Margin="0,12,0,4"/>
            <TextBox x:Name="TxtTelefone"/>

            <TextBlock Text="WhatsApp" FontWeight="SemiBold" Margin="0,12,0,4"/>
            <TextBox x:Name="TxtWhatsApp"/>

            <TextBlock Text="Observações (alergia, preferência de cadeira…)" FontWeight="SemiBold" Margin="0,12,0,4"/>
            <TextBox x:Name="TxtObs" Height="56" TextWrapping="Wrap" AcceptsReturn="True"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancelar" Style="{StaticResource GhostBtn}" Margin="0,0,8,0" Click="BtnCancelar_Click"/>
                <Button Content="Salvar cliente" Style="{StaticResource PrimaryBtn}" Click="BtnSalvar_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
