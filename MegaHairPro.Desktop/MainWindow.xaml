<Window x:Class="MegaHairPro.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tati Mega Hair — Recepção"
        Height="871" Width="1379" MinHeight="680" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Cream}"
        FontFamily="{StaticResource AppFont}"
        Foreground="{StaticResource Ink}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <!--
        TextOptions.* / UseLayoutRounding / SnapsToDevicePixels acima corrigem o
        problema de letras "ofuscadas e distorcidas": isso força o WPF a usar
        ClearType real e alinhar os pixels ao grid do dispositivo, em vez de
        deixar o texto ser escalado/borrado. Junto com o app.manifest com
        PerMonitorV2 DPI awareness, resolve em telas com escala 125%/150%/etc.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{StaticResource Wine}" Height="107" Margin="0,-2,0,55" Grid.RowSpan="2">
            <Grid Margin="22,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!--
                        Logo corrigido: caminho relativo simples funciona sempre que o
                        Build Action do PNG estiver como "Resource" (confira em
                        Solution Explorer > logo_tati_fundo_vinho.png > Propriedades).
                        O pack:// com ";component" só é necessário se você precisar
                        referenciar o recurso a partir de OUTRO assembly — aqui não
                        precisa, e era a causa mais provável de a imagem não aparecer
                        (nome do assembly diferente do que estava escrito no XAML).
                    -->
                    <Border Width="72" Height="72" CornerRadius="36" VerticalAlignment="Center"
                            Background="White" ClipToBounds="True">
                        <Image Source="/Assets/logo_tati_fundo_vinho.png"
                               Width="72" Height="72" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Tatiane Tognasca" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Recepção e caixa do salão" FontSize="11" Foreground="#E8B4C4"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="‹" Style="{StaticResource GhostBtn}" Foreground="White" FontSize="20" Width="40"
                            Click="BtnDiaAnterior_Click"/>
                    <Button MinWidth="220" Style="{StaticResource GhostBtn}" Foreground="White" Click="BtnHoje_Click">
                        <StackPanel>
                            <TextBlock Text="{Binding DataAgendaTexto}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center"/>
                            <TextBlock Text="clique para hoje" FontSize="10" Foreground="#E8B4C4" HorizontalAlignment="Center"
                                       Visibility="{Binding EhHoje, Converter={StaticResource BoolToVisInv}}"/>
                        </StackPanel>
                    </Button>
                    <Button Content="›" Style="{StaticResource GhostBtn}" Foreground="White" FontSize="20" Width="40"
                            Click="BtnDiaProximo_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Relogio}" FontSize="22" FontWeight="SemiBold" Foreground="White"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="Atualizar" Style="{StaticResource GoldBtn}" Click="BtnAtualizar_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- KPIs -->
        <UniformGrid Grid.Row="1" Columns="5" Margin="18,14,18,0">
            <Grid Margin="0,28,10,-28">
                <Border Style="{StaticResource CardShadow}"/>
                <Border Style="{StaticResource KpiCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Agenda" FontSize="11" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding KpiTotal}" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Margin="0,26,10,-26">
                <Border Style="{StaticResource CardShadow}"/>
                <Border Style="{StaticResource KpiCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Aguardando" FontSize="11" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding KpiAguardando}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Gold}"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Margin="0,28,10,-28">
                <Border Style="{StaticResource CardShadow}"/>
                <Border Style="{StaticResource KpiCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Na cadeira" FontSize="11" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding KpiConfirmados}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Success}"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Margin="0,28,10,-28">
                <Border Style="{StaticResource CardShadow}"/>
                <Border Style="{StaticResource KpiCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Concluídos" FontSize="11" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding KpiConcluidos}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Info}"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Margin="0,28,0,-28">
                <Border Style="{StaticResource CardShadow}"/>
                <Border Style="{StaticResource KpiCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Caixa do dia" FontSize="11" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding KpiFaturado, StringFormat=R$ {0:N2}}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Wine}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </UniformGrid>

        <Grid Grid.Row="2" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Agenda -->
            <Grid Grid.Column="0">
                <Border Style="{StaticResource CardShadow}"/>
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,12,0,-12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="Fila do dia" FontWeight="SemiBold" FontSize="16"/>
                            <TextBox Margin="0,10,0,0" Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="TxtBusca_KeyDown" Tag="Nome, telefone ou WhatsApp"/>
                            <TextBlock Text="Nome, telefone ou WhatsApp" FontSize="10" Foreground="{StaticResource Muted}" Margin="4,2,0,0"/>

                            <ComboBox Margin="0,8,0,0" ItemsSource="{Binding FiltrosProfissional}"
                                      DisplayMemberPath="Nome" SelectedValuePath="Id"
                                      SelectedValue="{Binding FiltroProfissionalId}"
                                      SelectionChanged="FiltroProfissional_Changed"/>

                            <!--
                                Botão "novo cliente" adicionado (não existia no XAML original —
                                era essa a razão de "não aparecer": ele nunca tinha sido criado).
                                Ligue o Click ao método de cadastro de cliente no code-behind.
                            -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="Walk-in  ·  chegou agora" Style="{StaticResource PrimaryBtn}" Click="BtnNovoWalkIn_Click"/>
                                <Button Grid.Column="2" Content="Buscar" Style="{StaticResource OutlineBtn}" Click="BtnBuscar_Click"/>
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Button Content="+ Nova cliente" Style="{StaticResource OutlineBtn}" Click="BtnNovoCliente_Click"/>
                            </Grid>
                        </StackPanel>

                        <ListBox x:Name="ListaAgenda" BorderThickness="0" Background="Transparent"
                                 ItemsSource="{Binding AgendaHoje}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="ListaAgenda_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" Background="Transparent" CornerRadius="12" Padding="0">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#F8E8EE"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#FBF3F5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="10" Background="{Binding CorFundo, Converter={StaticResource StringToBrush}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="3" Background="{Binding CorStatus, Converter={StaticResource StringToBrush}}"/>
                                            <Grid Grid.Column="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource Wine}" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Inicial}" Foreground="White" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Horario}" FontWeight="Bold" Foreground="{StaticResource Wine}"/>
                                                        <TextBlock Text="{Binding StatusLabel}" HorizontalAlignment="Right" FontSize="11"
                                                                   Foreground="{Binding CorStatus, Converter={StaticResource StringToBrush}}" FontWeight="SemiBold"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding ClienteNome}" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ServicosResumo}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                                    <Grid Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding ProfissionalNome}" FontSize="11" Foreground="{StaticResource Muted}"/>
                                                        <TextBlock Text="{Binding ValorResumo}" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Atendimento -->
            <Grid Grid.Column="2">
                <Border Style="{StaticResource CardShadow}"/>
                <Border Style="{StaticResource Card}" Margin="0,12,0,-12">
                    <Grid>
                        <StackPanel x:Name="PainelVazio" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="72" Height="72" CornerRadius="36" Background="#F3EAE7" HorizontalAlignment="Center">
                                <TextBlock Text="◇" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Wine}"/>
                            </Border>
                            <TextBlock Text="Selecione uma cliente na fila" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,16,0,0"/>
                            <TextBlock Text="Ou registre um walk-in para quem chegou sem horário."
                                       FontSize="13" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>

                        <ScrollViewer x:Name="PainelAtendimento" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource Wine}">
                                        <TextBlock Text="{Binding InicialCliente}" Foreground="White" FontSize="22" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ClienteNome}" FontSize="22" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Horario}" Foreground="{StaticResource Wine}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding ProfissionalPrincipal}" Foreground="{StaticResource Muted}" FontSize="12"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" VerticalAlignment="Top" CornerRadius="20" Padding="12,6"
                                            Background="#F8E8EE">
                                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Foreground="{StaticResource Wine}"/>
                                    </Border>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="{Binding ClienteTelefone}" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                    <Button Content="WhatsApp" Style="{StaticResource OutlineBtn}" Margin="12,0,0,0"
                                            Padding="12,6" Click="BtnWhatsApp_Click"
                                            Visibility="{Binding ClienteTelefone, Converter={StaticResource HasText}}"/>
                                    <Button Content="Cliente chegou" Style="{StaticResource SuccessBtn}" Margin="8,0,0,0"
                                            Padding="12,6" Click="BtnChegada_Click"
                                            Visibility="{Binding PodeCheckIn, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="Cancelar horário" Style="{StaticResource DangerBtn}" Margin="8,0,0,0"
                                            Padding="12,6" Click="BtnCancelar_Click"
                                            Visibility="{Binding PodeCancelar, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <Border Background="#FEF2F2" CornerRadius="10" Padding="12" Margin="0,12,0,0"
                                        Visibility="{Binding TemAlertaAnamnese, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="Atenção — anamnese" FontWeight="SemiBold" Foreground="{StaticResource Danger}"/>
                                        <TextBlock Text="{Binding AlertaAnamnese}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding ClienteObservacoes}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource Muted}" Margin="0,10,0,0"
                                           Visibility="{Binding ClienteObservacoes, Converter={StaticResource HasText}}"/>

                                <Separator Margin="0,16" Background="{StaticResource Line}"/>

                                <Grid>
                                    <TextBlock Text="Serviços" FontWeight="SemiBold" FontSize="15"/>
                                    <Button HorizontalAlignment="Right" Content="Marcar todos feitos" Style="{StaticResource GhostBtn}"
                                            Click="BtnMarcarTodos_Click"/>
                                </Grid>
                                <TextBlock Text="Defina a profissional de cada serviço — unha, maquiagem, mega hair podem ser pessoas diferentes."
                                           FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,10"/>

                                <DataGrid x:Name="GridServicos" MinHeight="140" MaxHeight="240"
                                          ItemsSource="{Binding ServicosAtendimento}">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="Feito" Binding="{Binding Realizado, UpdateSourceTrigger=PropertyChanged}" Width="58"/>
                                        <DataGridTextColumn Header="Serviço" Binding="{Binding Nome}" Width="*" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="100" IsReadOnly="True"/>
                                        <DataGridTemplateColumn Header="Profissional" Width="160">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.Profissionais, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              DisplayMemberPath="Nome" SelectedValuePath="Id"
                                                              SelectedValue="{Binding ProfissionalId, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Valor" Binding="{Binding Valor, StringFormat=R$ {0:N2}}" Width="90" IsReadOnly="True"/>
                                        <DataGridTemplateColumn Header="" Width="42">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="✕" Style="{StaticResource GhostBtn}" Foreground="{StaticResource Danger}"
                                                            Click="BtnRemoverServico_Click" Tag="{Binding}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CboServicoAdd" DisplayMemberPath="Nome"
                                              ItemsSource="{Binding ServicosDisponiveis}"
                                              SelectedItem="{Binding ServicoParaAdicionar}"/>
                                    <Button Grid.Column="1" Content="+ Serviço" Margin="8,0,0,0"
                                            Style="{StaticResource OutlineBtn}" Click="BtnAdicionarServico_Click"/>
                                    <Button Grid.Column="2" Content="Salvar" Margin="8,0,0,0"
                                            Style="{StaticResource PrimaryBtn}" Click="BtnSalvarServicos_Click"/>
                                </Grid>

                                <Separator Margin="0,16" Background="{StaticResource Line}"/>

                                <TextBlock Text="Caixa" FontWeight="SemiBold" FontSize="15"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#ECFDF3" CornerRadius="12" Padding="14" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="Total" FontSize="11" Foreground="{StaticResource Muted}"/>
                                            <TextBlock Text="{Binding ValorTotal, StringFormat=R$ {0:N2}}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Success}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#FFFBEB" CornerRadius="12" Padding="14" Margin="3,0">
                                        <StackPanel>
                                            <TextBlock Text="Sinal" FontSize="11" Foreground="{StaticResource Muted}"/>
                                            <TextBlock Text="{Binding SinalTexto}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#EFF6FF" CornerRadius="12" Padding="14" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Restante" FontSize="11" Foreground="{StaticResource Muted}"/>
                                            <TextBlock Text="{Binding RestanteTexto}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <TextBlock Text="Forma de pagamento" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox Width="180" ItemsSource="{Binding FormasPagamento}"
                                              SelectedItem="{Binding FormaPagamento}"/>
                                </StackPanel>

                                <WrapPanel Margin="0,16,0,8">
                                    <Button Content="Receber sinal" Style="{StaticResource SuccessBtn}" Margin="0,0,8,8"
                                            Click="BtnReceberSinal_Click"/>
                                    <Button Content="Fechar · restante" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,8"
                                            Click="BtnFecharRestante_Click"/>
                                    <Button Content="Fechar · pagar tudo" Style="{StaticResource GoldBtn}" Margin="0,0,8,8"
                                            Click="BtnFecharTotal_Click"/>
                                    <Button Content="Limpar seleção" Style="{StaticResource GhostBtn}" Margin="0,0,8,8"
                                            Click="BtnLimpar_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
