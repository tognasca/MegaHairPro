<Window x:Class="MegaHairPro.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MegaHair Pro — Atendimento" Height="780" Width="1180"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#f8fafc">
    <Window.Resources>
        <SolidColorBrush x:Key="Primary" Color="#7c3aed"/>
        <SolidColorBrush x:Key="PrimaryDark" Color="#5b21b6"/>
        <SolidColorBrush x:Key="Success" Color="#16a34a"/>
        <SolidColorBrush x:Key="CardBg" Color="#ffffff"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748b"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="#e2e8f0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryDark}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="{StaticResource Success}"/>
        </Style>

        <Style x:Key="OutlineBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Primary}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource Primary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Atendimento do Salão" FontSize="24" FontWeight="Bold" Foreground="#1e293b"/>
            <TextBlock Text="Recepção, serviços por profissional e fechamento de pagamentos" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Painel esquerdo: Agenda -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Agenda de Hoje" FontWeight="SemiBold" FontSize="15"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtBusca" Padding="10,8" FontSize="13"
                                     BorderBrush="#cbd5e1" Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Content="🔍" Margin="6,0,0,0" Padding="10,6"
                                    Style="{StaticResource OutlineBtn}" Click="BtnBuscar_Click"/>
                        </Grid>
                        <Button Content="+ Walk-in (sem horário)" Margin="0,10,0,0"
                                Style="{StaticResource OutlineBtn}" Click="BtnNovoWalkIn_Click"/>
                    </StackPanel>

                    <ListBox x:Name="ListaAgenda" BorderThickness="0" Background="Transparent"
                             SelectionChanged="ListaAgenda_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" Margin="0,0,0,6" CornerRadius="8" Background="#f1f5f9" Cursor="Hand">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Horario}" FontWeight="Bold" Foreground="{StaticResource Primary}"/>
                                            <TextBlock Text="{Binding Status}" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding ClienteNome}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding ServicosResumo}" FontSize="11" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Painel direito: Atendimento -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <StackPanel x:Name="PainelVazio" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Visible">
                        <TextBlock Text="👋" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="Selecione um agendamento ou crie um walk-in" FontSize="15"
                                   Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>

                    <ScrollViewer x:Name="PainelAtendimento" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Dados da cliente -->
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{Binding ClienteNome}" FontSize="20" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ClienteTelefone}" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Horario}" Foreground="{StaticResource Primary}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#ede9fe"
                                        CornerRadius="20" Padding="12,6">
                                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Foreground="{StaticResource Primary}"/>
                                </Border>
                            </Grid>

                            <Separator Margin="0,16"/>

                            <!-- Serviços -->
                            <TextBlock Text="Serviços do atendimento" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="Marque como realizado e defina a profissional de cada serviço (unha, maquiagem, etc.)"
                                       FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,10"/>

                            <DataGrid x:Name="GridServicos" AutoGenerateColumns="False" CanUserAddRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      BorderBrush="#e2e8f0" Background="White" MinHeight="120" MaxHeight="220"
                                      ItemsSource="{Binding ServicosAtendimento}">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Feito" Binding="{Binding Realizado, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                                    <DataGridTextColumn Header="Serviço" Binding="{Binding Nome}" Width="*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="90" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="Profissional" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding DataContext.Profissionais, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="Nome" SelectedValuePath="Id"
                                                          SelectedValue="{Binding ProfissionalId, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Valor" Binding="{Binding Valor, StringFormat=R$ {0:N2}}" Width="90" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="" Width="40">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕" Background="Transparent" BorderThickness="0"
                                                        Foreground="#ef4444" Click="BtnRemoverServico_Click" Tag="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CboServicoAdd" DisplayMemberPath="Nome"
                                          SelectedItem="{Binding ServicoParaAdicionar}" Padding="8,6"/>
                                <Button Grid.Column="1" Content="+ Adicionar" Margin="8,0,0,0"
                                        Style="{StaticResource OutlineBtn}" Click="BtnAdicionarServico_Click"/>
                                <Button Grid.Column="2" Content="Salvar serviços" Margin="8,0,0,0"
                                        Style="{StaticResource PrimaryBtn}" Click="BtnSalvarServicos_Click"/>
                            </Grid>

                            <Separator Margin="0,16"/>

                            <!-- Pagamento -->
                            <TextBlock Text="Pagamento" FontWeight="SemiBold" FontSize="14"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#f0fdf4" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="Total" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="{Binding ValorTotal, StringFormat=R$ {0:N2}}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Success}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#fefce8" CornerRadius="8" Padding="12" Margin="3,0">
                                    <StackPanel>
                                        <TextBlock Text="Sinal (agendamento)" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="{Binding SinalTexto}" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="#eff6ff" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Restante" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="{Binding RestanteTexto}" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBlock Text="Forma de pagamento:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Width="160" ItemsSource="{Binding FormasPagamento}"
                                          SelectedItem="{Binding FormaPagamento}" Padding="8,6"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="Receber Sinal" Style="{StaticResource SuccessBtn}" Margin="0,0,8,0"
                                        Click="BtnReceberSinal_Click"/>
                                <Button Content="Fechar — Pagar Restante" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0"
                                        Click="BtnFecharRestante_Click"/>
                                <Button Content="Fechar — Pagar Tudo" Style="{StaticResource OutlineBtn}" Margin="0,0,8,0"
                                        Click="BtnFecharTotal_Click"/>
                                <Button Content="Limpar" Background="Transparent" BorderThickness="0"
                                        Foreground="{StaticResource TextMuted}" Click="BtnLimpar_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
