<Window x:Class="MegaHairPro.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tati Mega Hair — Recepção"
        Height="900" Width="1440" MinHeight="600" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResize"
        Background="{StaticResource Cream}"
        FontFamily="{StaticResource AppFont}"
        Foreground="{StaticResource Ink}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="88"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{StaticResource Wine}">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="52" Height="52" CornerRadius="26" VerticalAlignment="Center"
                            Background="White" ClipToBounds="True">
                        <Image Source="/Assets/logo_tati_fundo_vinho.png"
                               Width="52" Height="52" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Tatiane Tognasca" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Recepção · caixa" FontSize="11" Foreground="#E8B4C4"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="‹" Style="{StaticResource GhostBtn}" Foreground="White" FontSize="20" Width="40"
                            Click="BtnDiaAnterior_Click"/>
                    <Button MinWidth="240" Style="{StaticResource GhostBtn}" Foreground="White" Click="BtnHoje_Click">
                        <StackPanel>
                            <TextBlock Text="{Binding DataAgendaTexto}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center"/>
                            <TextBlock Text="voltar para hoje" FontSize="10" Foreground="#E8B4C4" HorizontalAlignment="Center"
                                       Visibility="{Binding EhHoje, Converter={StaticResource BoolToVisInv}}"/>
                        </StackPanel>
                    </Button>
                    <Button Content="›" Style="{StaticResource GhostBtn}" Foreground="White" FontSize="20" Width="40"
                            Click="BtnDiaProximo_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Relogio}" FontSize="22" FontWeight="SemiBold" Foreground="White"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="Tela cheia" Style="{StaticResource GhostBtn}" Foreground="White"
                            Margin="0,0,8,0" Padding="12,8" Click="BtnTelaCheia_Click"
                            ToolTip="F11 — preenche o monitor (notebook ou 32&quot;)"/>
                    <Button Content="Atualizar" Style="{StaticResource GoldBtn}" Click="BtnAtualizar_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- KPIs -->
        <UniformGrid Grid.Row="1" Columns="5" Margin="18,12,18,0">
            <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Agenda" FontSize="11" Foreground="{StaticResource Muted}"/>
                    <TextBlock Text="{Binding KpiTotal}" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Aguardando" FontSize="11" Foreground="{StaticResource Muted}"/>
                    <TextBlock Text="{Binding KpiAguardando}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Gold}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Na cadeira" FontSize="11" Foreground="{StaticResource Muted}"/>
                    <TextBlock Text="{Binding KpiConfirmados}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Success}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Concluídos" FontSize="11" Foreground="{StaticResource Muted}"/>
                    <TextBlock Text="{Binding KpiConcluidos}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Info}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource KpiCard}" Margin="0">
                <StackPanel>
                    <TextBlock Text="Caixa do dia" FontSize="11" Foreground="{StaticResource Muted}"/>
                    <TextBlock Text="{Binding KpiFaturado, StringFormat=R$ {0:N2}}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Wine}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2" Margin="18,10,18,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" MinWidth="280"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="2.2*" MinWidth="520"/>
            </Grid.ColumnDefinitions>

            <!-- Fila -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Fila do dia" FontWeight="SemiBold" FontSize="16"/>
                        <TextBox Margin="0,10,0,0" Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="TxtBusca_KeyDown"/>
                        <TextBlock Text="Nome, telefone ou WhatsApp" FontSize="10" Foreground="{StaticResource Muted}" Margin="4,2,0,0"/>

                        <ComboBox Margin="0,8,0,0" ItemsSource="{Binding FiltrosProfissional}"
                                  DisplayMemberPath="Nome" SelectedValuePath="Id"
                                  SelectedValue="{Binding FiltroProfissionalId}"
                                  SelectionChanged="FiltroProfissional_Changed"/>

                        <Button Margin="0,10,0,0" Content="Walk-in  ·  chegou agora" Style="{StaticResource PrimaryBtn}" Click="BtnNovoWalkIn_Click"/>
                        <Button Margin="0,8,0,0" Content="+ Nova cliente" Style="{StaticResource OutlineBtn}" Click="BtnNovoCliente_Click"/>
                    </StackPanel>

                    <ListBox x:Name="ListaAgenda" BorderThickness="0" Background="Transparent"
                             ItemsSource="{Binding AgendaHoje}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="ListaAgenda_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="Transparent" CornerRadius="12" Padding="0">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#F8E8EE"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#FBF3F5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="10" Background="{Binding CorFundo, Converter={StaticResource StringToBrush}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="3" Background="{Binding CorStatus, Converter={StaticResource StringToBrush}}"/>
                                        <StackPanel Grid.Column="2">
                                            <Grid>
                                                <TextBlock Text="{Binding Horario}" FontWeight="Bold" Foreground="{StaticResource Wine}"/>
                                                <TextBlock Text="{Binding StatusLabel}" HorizontalAlignment="Right" FontSize="11"
                                                           Foreground="{Binding CorStatus, Converter={StaticResource StringToBrush}}" FontWeight="SemiBold"/>
                                            </Grid>
                                            <TextBlock Text="{Binding ClienteNome}" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ServicosResumo}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                            <Grid Margin="0,2,0,0">
                                                <TextBlock Text="{Binding ProfissionalNome}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ValorResumo}" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Atendimento -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid Margin="16">
                    <StackPanel x:Name="PainelVazio" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="32" Background="#F3EAE7" HorizontalAlignment="Center">
                            <TextBlock Text="◇" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Wine}"/>
                        </Border>
                        <TextBlock Text="Selecione uma cliente na fila" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock Text="Ou registre umSem Agendamento para quem chegou sem horário."
                                   FontSize="13" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>

                    <Grid x:Name="PainelAtendimento" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Cliente -->
                        <Border Grid.Row="0" Background="{StaticResource WineLight}" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource Wine}">
                                    <TextBlock Text="{Binding InicialCliente}" Foreground="White" FontSize="18" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ClienteNome}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Horario}" Foreground="{StaticResource Wine}" FontSize="12" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding ProfissionalPrincipal}" Foreground="{StaticResource Muted}" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Border CornerRadius="16" Padding="12,5" Background="White" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding StatusLabelAmigavel}" FontWeight="SemiBold" Foreground="{StaticResource Wine}"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right">
                                        <Button Content="WhatsApp" Style="{StaticResource OutlineBtn}" Padding="10,6" Margin="0,0,6,0"
                                                Click="BtnWhatsApp_Click"
                                                Visibility="{Binding ClienteTelefone, Converter={StaticResource HasText}}"/>
                                        <Button Content="Chegou" Style="{StaticResource SuccessBtn}" Padding="10,6" Margin="0,0,6,0"
                                                Click="BtnChegada_Click"
                                                Visibility="{Binding PodeCheckIn, Converter={StaticResource BoolToVis}}"/>
                                        <Button Content="Cancelar" Style="{StaticResource DangerBtn}" Padding="10,6"
                                                Click="BtnCancelar_Click"
                                                Visibility="{Binding PodeCancelar, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.7*" MinWidth="320"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="0.95*" MinWidth="280"/>
                            </Grid.ColumnDefinitions>

                            <!-- Serviços -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*" MinHeight="140"/>
                                    <RowDefinition Height="0.42*" MinHeight="120"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="Serviços desta visita" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                                    <Button HorizontalAlignment="Right" Content="Marcar todos feitos" Style="{StaticResource GhostBtn}"
                                            Click="BtnMarcarTodos_Click"/>
                                </Grid>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding ServicosAtendimento}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="12" Padding="10" Margin="0,0,0,8"
                                                        BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                        Background="{Binding Categoria, Converter={StaticResource CatFundo}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ToggleButton Width="40" Height="40" Cursor="Hand"
                                                                      IsChecked="{Binding Realizado, UpdateSourceTrigger=PropertyChanged}">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border x:Name="chk" Width="40" Height="40" CornerRadius="10"
                                                                            Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1.5">
                                                                        <TextBlock x:Name="mark"
                                                                                   Text="{Binding DataContext.Categoria, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource CatIcone}}"
                                                                                   FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsChecked" Value="True">
                                                                            <Setter TargetName="chk" Property="Background" Value="{StaticResource Success}"/>
                                                                            <Setter TargetName="chk" Property="BorderBrush" Value="{StaticResource Success}"/>
                                                                            <Setter TargetName="mark" Property="Text" Value="✓"/>
                                                                            <Setter TargetName="mark" Property="Foreground" Value="White"/>
                                                                            <Setter TargetName="mark" Property="FontWeight" Value="Bold"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                        </ToggleButton>
                                                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <ComboBox Margin="0,6,0,0" MaxWidth="220" HorizontalAlignment="Left"
                                                                      ItemsSource="{Binding DataContext.Profissionais, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      DisplayMemberPath="Nome" SelectedValuePath="Id"
                                                                      SelectedValue="{Binding ProfissionalId, UpdateSourceTrigger=PropertyChanged}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Valor, StringFormat=R$ {0:N2}}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                            <Button Content="Remover" Style="{StaticResource GhostBtn}" Foreground="{StaticResource Danger}"
                                                                    Padding="6,2" FontSize="11" HorizontalAlignment="Right"
                                                                    Click="BtnRemoverServico_Click" Tag="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Border Grid.Row="2" Background="{StaticResource CreamSoft}" CornerRadius="12" Padding="10" Margin="0,10,0,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="Adicionar serviço" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding CatalogoServicos}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource ChipBtn}"
                                                                Click="BtnCatalogoServico_Click" Tag="{Binding Id}"
                                                                IsEnabled="{Binding DataContext.PodeEditarServicos, RelativeSource={RelativeSource AncestorType=Window}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Categoria, Converter={StaticResource CatIcone}}" Margin="0,0,6,0"/>
                                                                <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                                                                           Text="{Binding ValorFinal, StringFormat=R$ {0:N0}}"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Grid>

                            <!-- Caixa -->
                            <Border Grid.Column="2" Background="{StaticResource CreamSoft}" CornerRadius="14" Padding="14">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Caixa" FontWeight="SemiBold" FontSize="16"/>

                                    <StackPanel DockPanel.Dock="Bottom">
                                        <Button Content="Confirmar pagamento" Style="{StaticResource PrimaryBtn}" Margin="0,0,0,8"
                                                Click="BtnFecharTotal_Click"
                                                IsEnabled="{Binding PodeFechar}"/>
                                        <Button Content="Receber só o sinal" Style="{StaticResource OutlineBtn}" Margin="0,0,0,8"
                                                Click="BtnReceberSinal_Click"
                                                IsEnabled="{Binding PodeReceberSinal}"/>
                                        <Button Content="Receber restante" Style="{StaticResource GoldBtn}" Margin="0,0,0,8"
                                                Click="BtnFecharRestante_Click"
                                                IsEnabled="{Binding PodeFechar}"/>
                                        <Button Content="Fechar ficha" Style="{StaticResource GhostBtn}"
                                                Click="BtnLimpar_Click"/>
                                    </StackPanel>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10">
                                        <StackPanel>
                                            <Border Background="#ECFDF3" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="Total dos serviços" FontSize="11" Foreground="{StaticResource Muted}"/>
                                                    <TextBlock Text="{Binding ValorTotal, StringFormat=R$ {0:N2}}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Success}"/>
                                                </StackPanel>
                                            </Border>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="White" CornerRadius="10" Padding="10">
                                                    <StackPanel>
                                                        <TextBlock Text="Já no caixa" FontSize="10" Foreground="{StaticResource Muted}"/>
                                                        <TextBlock Text="{Binding ValorJaNoCaixa, StringFormat=R$ {0:N2}}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="10">
                                                    <StackPanel>
                                                        <TextBlock Text="A receber" FontSize="10" Foreground="{StaticResource Muted}"/>
                                                        <TextBlock Text="{Binding ValorAReceber, StringFormat=R$ {0:N2}}" FontWeight="Bold" Foreground="{StaticResource Wine}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <TextBlock Text="{Binding SinalTexto}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding RestanteTexto}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>

                                            <TextBlock Text="Como pagou agora" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <UniformGrid Columns="2">
                                                <RadioButton GroupName="Pagamento" Style="{StaticResource ChoiceTile}" Margin="0,0,6,6"
                                                             Tag="PIX" Checked="Pagamento_Checked"
                                                             IsChecked="{Binding FormaPagamento, Mode=TwoWay, Converter={StaticResource StrEq}, ConverterParameter=PIX}">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="Pix" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Na hora" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton GroupName="Pagamento" Style="{StaticResource ChoiceTile}" Margin="0,0,0,6"
                                                             Tag="Dinheiro" Checked="Pagamento_Checked"
                                                             IsChecked="{Binding FormaPagamento, Mode=TwoWay, Converter={StaticResource StrEq}, ConverterParameter=Dinheiro}">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="Dinheiro" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Espécie" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton GroupName="Pagamento" Style="{StaticResource ChoiceTile}" Margin="0,0,6,0"
                                                             Tag="Cartão Débito" Checked="Pagamento_Checked"
                                                             IsChecked="{Binding FormaPagamento, Mode=TwoWay, Converter={StaticResource StrEq}, ConverterParameter=Cartão Débito}">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="Débito" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Maquininha" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton GroupName="Pagamento" Style="{StaticResource ChoiceTile}" Margin="0"
                                                             Tag="Cartão Crédito" Checked="Pagamento_Checked"
                                                             IsChecked="{Binding FormaPagamento, Mode=TwoWay, Converter={StaticResource StrEq}, ConverterParameter=Cartão Crédito}">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="Crédito" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Maquininha" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </RadioButton>
                                            </UniformGrid>
                                        </StackPanel>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
