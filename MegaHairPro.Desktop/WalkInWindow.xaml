<Window x:Class="MegaHairPro.Desktop.WalkInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Walk-in — chegou sem horário" Height="620" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Cream}"
        FontFamily="{StaticResource AppFont}"
        Foreground="{StaticResource Ink}">
    <Border Margin="18" Style="{StaticResource Card}" Padding="22">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancelar" Style="{StaticResource GhostBtn}" Margin="0,0,8,0" Click="BtnCancelar_Click"/>
                <Button Content="Iniciar atendimento" Style="{StaticResource PrimaryBtn}" Click="BtnIniciar_Click"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Walk-in" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Cliente chegou agora. Encontre o cadastro ou crie um novo e escolha os serviços."
                           Foreground="{StaticResource Muted}" Margin="0,4,0,16" TextWrapping="Wrap"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtFiltroCliente"/>
                    <Button Grid.Column="2" Content="Buscar" Style="{StaticResource OutlineBtn}" Click="BtnBuscarCliente_Click"/>
                </Grid>
                <TextBlock Text="Nome, telefone ou WhatsApp" FontSize="10" Foreground="{StaticResource Muted}" Margin="2,4,0,0"/>

                <ComboBox x:Name="CboCliente" DisplayMemberPath="Nome" Margin="0,8,0,0"
                          SelectionChanged="CboCliente_SelectionChanged"/>

                <Button Content="+ Nova cliente" Style="{StaticResource GhostBtn}" HorizontalAlignment="Left"
                        Margin="0,6,0,0" Click="BtnNovaCliente_Click"/>

                <TextBlock Text="Profissional principal" FontWeight="SemiBold" Margin="0,16,0,6"/>
                <ComboBox x:Name="CboProfissional" DisplayMemberPath="Nome"/>

                <TextBlock Text="Serviços" FontWeight="SemiBold" Margin="0,16,0,6"/>
                <TextBlock Text="Segure Ctrl para marcar unha + maquiagem + cabelo juntos."
                           FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                <ListBox x:Name="LstServicos" DisplayMemberPath="Nome" SelectionMode="Multiple"
                         Height="180" BorderBrush="{StaticResource Line}" BorderThickness="1"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
