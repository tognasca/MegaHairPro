@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>Login | MegaHairPro</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            font-family: 'Poppins', sans-serif;
        }

        html, body {
            height: 100%;
            margin: 0;
        }

        /* 🌌 Fundo com degradê + luz */
        .login-page {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: radial-gradient(circle at top, #ff758f22, transparent 40%), linear-gradient(135deg, #0f172a, #1e293b, #020617);
            padding: 20px;
        }

        /* 🧊 Card vidro (glassmorphism) */
        .login-card {
            width: 100%;
            max-width: 430px;
            padding: 50px 40px;
            border-radius: 24px;
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border: 1px solid rgba(255,255,255,0.15);
            box-shadow: 0 25px 80px rgba(0,0,0,0.45), inset 0 1px 0 rgba(255,255,255,0.08);
            color: white;
            text-align: center;
        }

        /* Logo / título */
        .login-logo {
            font-size: 2.3rem;
            font-weight: 700;
            background: linear-gradient(90deg, #ff4d6d, #ff9ab0);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 10px;
        }

        .login-subtitle {
            color: #cbd5e1;
            font-size: 0.95rem;
            margin-bottom: 35px;
        }

        /* Inputs */
        .form-control {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 14px;
            padding: 14px;
            color: white;
        }

            .form-control::placeholder {
                color: #94a3b8;
            }

            .form-control:focus {
                background: rgba(255,255,255,0.12);
                border-color: #ff4d6d;
                box-shadow: 0 0 0 3px #ff4d6d33;
                color: white;
            }

        label {
            font-weight: 500;
            margin-bottom: 6px;
            float: left;
        }

        /* Botão */
        .btn-login {
            background: linear-gradient(90deg, #ff4d6d, #ff758f);
            border: none;
            padding: 14px;
            font-size: 1.05rem;
            border-radius: 14px;
            font-weight: 600;
            margin-top: 10px;
            transition: 0.3s;
            box-shadow: 0 10px 25px #ff4d6d55;
        }

            .btn-login:hover {
                transform: translateY(-2px);
                box-shadow: 0 15px 35px #ff4d6d88;
            }

        /* Alert */
        .alert {
            border-radius: 12px;
            font-size: 0.9rem;
        }

        /* Responsivo */
        @@media (max-width: 500px) {
            .login-card {
                padding: 40px 25px;
            }
        }

        }
    </style>
</head>

<body>
    <div class="login-page">

        <div class="login-card">
            <div class="login-logo">
                MegaHair Pro
                <div class="login-subtitle">
                    By Tatiane Tognasca
                </div>
            </div>
            <div class="login-logo">
                MegaHair Pro
                <div class="login-subtitle">
                    By Tatiane Tognasca
                </div>
            </div>
            <div class="login-subtitle">
                Acesse sua plataforma profissional
            </div>

            @if (ViewBag.Erro != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Erro
                </div>
            }

            <form method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3 text-start">
                    <label>Email</label>
                    <input name="email" class="form-control" required />
                </div>

                <div class="mb-3 text-start">
                    <label>Senha</label>
                    <input name="senha" type="password" class="form-control" required />
                </div>

                <button class="btn btn-login w-100">
                    Entrar no Sistema
                </button>

            </form>

        </div>
    </div>
</body>

</html>
<script>
    function toggleSenha() {
        let s = document.getElementById("senha");
        s.type = s.type === "password" ? "text" : "password";
    }
</script>