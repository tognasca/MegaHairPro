@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>Login | MegaHairPro</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #f3f4f6;
        }

        /* CENTRALIZA */
        .login-page {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        /* CARD PADRÃO */
        .login-card {
            width: 100%;
            max-width: 400px;
            background: #ffffff;
            padding: 35px;
            border-radius: 10px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.08);
            text-align: center;
        }

        /* LOGO */
        /* BLOCO TOPO */
        .login-header {
            text-align: center;
            margin-bottom: 25px;
        }

        /* LOGO */
        /* FAIXA ESCURA DO TOPO */
        .login-header-dark {
            background: #000; /* preto sólido */
            padding: 25px 20px;
            margin: -35px -35px 25px -35px;
            border-radius: 10px 10px 0 0;
            text-align: center;
        }

        /* LOGO */
        .logo-img {
            width: 140px;
            height: auto;
            margin-bottom: 10px;
        }

        /* TEXTO BRANCO */
        .login-header-dark .login-subtitle {
            color: #e5e7eb;
            font-size: 0.85rem;
        }

        .login-header-dark .login-subtitle2 {
            color: #9ca3af;
            font-size: 0.85rem;
        }



        /* LABEL */
        label {
            font-weight: 600;
            margin-bottom: 5px;
            display: block;
            text-align: left;
        }

        /* INPUT */
        .form-control {
            border-radius: 8px;
            padding: 12px;
        }

        /* BOTÃO PADRÃO */
        .btn-login {
            background: #111827;
            color: #fff;
            border: none;
            padding: 12px;
            border-radius: 8px;
            font-weight: 600;
            margin-top: 10px;
            transition: 0.2s;
        }

            .btn-login:hover {
                background: #000;
            }

        /* ALERTA */
        .alert {
            font-size: 0.9rem;
            border-radius: 8px;
        }
    </style>
</head>

<body>

    <div class="login-page">

        <div class="login-card">

            <div class="login-header-dark">

                <img src="~/Imagem/LogoMegaHairPro.png" class="logo-img" />

                <div class="login-subtitle">
                    By Tatiane Tognasca
                </div>

                <div class="login-subtitle2">
                    Acesse sua plataforma profissional
                </div>

            </div>


            @if (ViewBag.Erro != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Erro
                </div>
            }

            <form method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label>Email</label>
                    <input name="email" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label>Senha</label>
                    <input name="senha" type="password" class="form-control" required />
                </div>

                <button class="btn btn-login w-100">
                    Entrar no Sistema
                </button>

            </form>

        </div>

    </div>

</body>
</html>

<script>
    function toggleSenha() {
        let s = document.getElementById("senha");
        s.type = s.type === "password" ? "text" : "password";
    }
</script>