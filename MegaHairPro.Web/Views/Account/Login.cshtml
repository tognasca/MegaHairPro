@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>Login | MegaHairPro</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: linear-gradient(135deg, #111827, #1f2937);
            min-height: 100vh;
        }

        .login-box {
            background: #fff;
            border-radius: 10px;
            padding: 30px;
            width: 100%;
            max-width: 380px;
        }
    </style>
</head>

<body class="d-flex align-items-center justify-content-center">

    <div class="login-box shadow">
        <h3 class="text-center mb-4">MegaHairPro</h3>

        <form method="post">
            <div class="mb-3">
                <label class="form-label">Usuário</label>
                <input name="login" class="form-control" placeholder="Digite seu usuário" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Senha</label>
                <input name="senha" type="password" class="form-control" placeholder="Digite sua senha" required />
            </div>

            <button class="btn btn-dark w-100 mt-2">
                Entrar
            </button>
        </form>
    </div>

</body>
</html>
