@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>Login | MegaHairPro</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">

    <style>
        :root {
            --navy:      #1a2e4a;
            --navy-dark: #0f1e30;
            --navy-mid:  #243858;
            --gold:      #c9a84c;
            --gold-light:#e2c47a;
            --white:     #ffffff;
            --gray-100:  #f4f6f9;
            --gray-300:  #cbd2dc;
            --gray-500:  #7a8699;
            --text:      #1a2e4a;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--navy-dark);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                radial-gradient(ellipse 80% 60% at 20% 50%, rgba(201,168,76,0.07) 0%, transparent 60%),
                radial-gradient(ellipse 60% 80% at 80% 20%, rgba(26,46,74,0.9) 0%, transparent 70%);
            pointer-events: none;
        }

        body::after {
            content: '';
            position: fixed;
            inset: 0;
            background-image:
                linear-gradient(rgba(201,168,76,0.04) 1px, transparent 1px),
                linear-gradient(90deg, rgba(201,168,76,0.04) 1px, transparent 1px);
            background-size: 48px 48px;
            pointer-events: none;
        }

        .login-page {
            position: relative;
            z-index: 1;
            width: 100%;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            background: var(--white);
            border-radius: 16px;
            overflow: hidden;
            box-shadow:
                0 0 0 1px rgba(201,168,76,0.25),
                0 24px 64px rgba(0,0,0,0.45),
                0 4px 16px rgba(0,0,0,0.3);
            animation: slideUp .5s cubic-bezier(.22,.61,.36,1) both;
        }

        @@keyframes slideUp {
            from { opacity: 0; transform: translateY(28px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .login-header {
            background: linear-gradient(160deg, var(--navy) 0%, var(--navy-dark) 100%);
            padding: 36px 36px 28px;
            text-align: center;
            position: relative;
            border-bottom: 1px solid rgba(201,168,76,0.2);
        }

        .login-header::after {
            content: '';
            position: absolute;
            bottom: 0; left: 50%; transform: translateX(-50%);
            width: 60%; height: 1px;
            background: linear-gradient(90deg, transparent, var(--gold), transparent);
        }

        .logo-img {
            width: 200px;
            height: auto;
            margin-bottom: 14px;
            filter: drop-shadow(0 2px 8px rgba(201,168,76,0.3));
        }

        .login-subtitle {
            font-family: 'Playfair Display', serif;
            font-size: 0.9rem;
            font-weight: 500;
            letter-spacing: 1.5px;
            background: linear-gradient(90deg, #c0c0c0, #f5f5f5, #c0c0c0);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 4px;
        }

        .login-subtitle2 {
            color: rgba(255,255,255,0.45);
            font-size: 0.78rem;
            letter-spacing: 0.5px;
        }

        .login-body {
            padding: 32px 36px 36px;
            background: var(--white);
        }

        .form-label {
            font-size: 0.78rem;
            font-weight: 600;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            color: var(--gray-500);
            margin-bottom: 6px;
            display: block;
        }

        .input-wrap {
            position: relative;
            margin-bottom: 20px;
        }

        .form-control {
            width: 100%;
            background: var(--gray-100);
            border: 1.5px solid transparent;
            border-radius: 10px;
            padding: 13px 44px 13px 14px;
            font-size: 0.95rem;
            color: var(--text);
            font-family: 'DM Sans', sans-serif;
            transition: border-color .2s, box-shadow .2s, background .2s;
            outline: none;
        }

        .form-control:focus {
            background: var(--white);
            border-color: var(--gold);
            box-shadow: 0 0 0 3px rgba(201,168,76,0.12);
        }

        .input-icon {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--gray-300);
            pointer-events: none;
        }

        .toggle-senha {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--gray-300);
            background: none;
            border: none;
            cursor: pointer;
            padding: 0;
            display: flex;
            align-items: center;
            transition: color .2s;
        }
        .toggle-senha:hover { color: var(--navy); }

        .btn-login {
            width: 100%;
            background: linear-gradient(135deg, var(--navy-mid) 0%, var(--navy-dark) 100%);
            color: var(--white);
            border: 1px solid rgba(201,168,76,0.3);
            border-radius: 10px;
            padding: 14px;
            font-size: 0.9rem;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            cursor: pointer;
            margin-top: 8px;
            transition: all .25s;
            position: relative;
            overflow: hidden;
            font-family: 'DM Sans', sans-serif;
        }

        .btn-login::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(201,168,76,0.15), transparent);
            opacity: 0;
            transition: opacity .25s;
        }

        .btn-login:hover {
            border-color: var(--gold);
            box-shadow: 0 4px 20px rgba(201,168,76,0.2);
            transform: translateY(-1px);
        }

        .btn-login:hover::before { opacity: 1; }
        .btn-login:active { transform: translateY(0); }

        .divider {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 24px 0 0;
        }
        .divider hr {
            flex: 1;
            border: none;
            border-top: 1px solid var(--gray-300);
        }
        .divider span {
            font-size: 0.72rem;
            color: var(--gray-500);
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        .login-footer {
            text-align: center;
            padding: 14px 36px 20px;
            font-size: 0.72rem;
            color: var(--gray-500);
            border-top: 1px solid var(--gray-100);
        }

        .alert-danger {
            background: #fef2f2;
            border: 1px solid #fca5a5;
            color: #b91c1c;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 0.85rem;
            margin-bottom: 18px;
        }

        .gold-dot {
            display: inline-block;
            width: 5px; height: 5px;
            background: var(--gold);
            border-radius: 50%;
            margin: 0 6px;
            vertical-align: middle;
        }
    </style>
</head  

<body>
    <div class="login-page">
        <div class="login-card">

            <div class="login-header">
                <img src="~/Imagem/LogoMegaHairPro.png" class="logo-img" alt="MegaHairPro" />
                <div class="login-subtitle">By Tatiane Tognasca</div>
                <div class="login-subtitle2">Acesse sua plataforma profissional</div>
            </div>

            <div class="login-body">

                @if (ViewBag.Erro != null)
                {
                    <div class="alert-danger">@ViewBag.Erro</div>
                }

                <form method="post">
                    @Html.AntiForgeryToken()

                    <div class="input-wrap">
                        <label class="form-label">E-mail</label>
                        <input name="email" type="email" class="form-control" placeholder="seu@email.com" required />
                        <span class="input-icon">
                            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/>
                            </svg>
                        </span>
                    </div>

                    <div class="input-wrap">
                        <label class="form-label">Senha</label>
                        <input id="senha" name="senha" type="password" class="form-control" placeholder="••••••••" required />
                        <button type="button" class="toggle-senha" onclick="toggleSenha()" title="Mostrar/ocultar senha">
                            <svg id="icon-eye" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
                            </svg>
                        </button>
                    </div>

                    <button type="submit" class="btn-login">
                        Entrar no Sistema
                    </button>

                </form>

                <div class="divider">
                    <hr/><span><span class="gold-dot"></span> MegaHairPro <span class="gold-dot"></span></span><hr/>
                </div>
            </div>

            <div class="login-footer">
                &copy; 2025 MegaHairPro &mdash; By Tatiane Tognasca. Todos os direitos reservados.
            </div>

        </div>
    </div>

    <script>
        function toggleSenha() {
            const s = document.getElementById("senha");
            s.type = s.type === "password" ? "text" : "password";
        }
    </script>
</body>
</html>
