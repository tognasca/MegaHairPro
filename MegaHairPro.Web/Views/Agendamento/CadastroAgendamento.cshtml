@model MegaHairPro.Web.Models.Agendamento

@{
    ViewData["Title"] = "Agendamentos";
}

<div class="page-header">
    <div>
        <div class="page-title">Novo Agendamento</div>
        <div class="page-sub">Preencha os dados para registrar o agendamento</div>
    </div>
</div>

<div class="section-card">
    <form asp-action="CadastroAgendamento" method="post">
        @Html.AntiForgeryToken()

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Cliente</label>
                <select asp-for="ClienteId" asp-items="ViewBag.Clientes" class="form-select" required>
                    <option value="">Selecione o cliente...</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Profissional</label>
                <select asp-for="ProfissionalId" asp-items="ViewBag.Profissionais" class="form-select" required>
                    <option value="">Selecione o profissional...</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Data e Hora</label>
                <input type="datetime-local" asp-for="DataHora" class="form-control" required />
            </div>
        </div>

        <div class="mt-4">
            <div class="section-label mb-3">Serviços</div>
            <div class="row g-3">
                @foreach (var s in ViewBag.Servicos)
                {
                    <div class="col-md-4">
                        <label class="servico-card-label" for="servico-@s.Id">
                            <input type="checkbox" name="servicosSelecionados" value="@s.Id" id="servico-@s.Id" class="servico-check" />
                            <div class="servico-card-body">
                                <div class="servico-nome">@s.Nome</div>
                                <div class="servico-info">R$ @s.Valor</div>
                            </div>
                        </label>
                    </div>
                }
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn px-5 py-2" style="background:var(--navy,#1a2e4a);color:#fff;border-radius:8px;font-weight:600">
                Agendar
            </button>
        </div>
    </form>
</div>

<style>
    .servico-card-label {
        display: block;
        border: 1.5px solid #e5e7eb;
        border-radius: 10px;
        padding: 14px 16px;
        cursor: pointer;
        transition: border-color .2s, background .2s;
        position: relative;
    }
    .servico-card-label:hover { border-color: #9ca3af; background: #fafafa; }
    .servico-card-label:has(.servico-check:checked) { border-color: var(--navy,#1a2e4a); background: #f0f4f8; }
    .servico-check { position:absolute; top:14px; right:14px; width:16px; height:16px; accent-color: var(--navy,#1a2e4a); }
    .servico-nome { font-weight: 600; font-size: .9rem; margin-bottom: 4px; padding-right: 24px; }
    .servico-info { font-size: .82rem; color: #6b7280; }
</style>
