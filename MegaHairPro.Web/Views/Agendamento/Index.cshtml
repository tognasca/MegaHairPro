@{
    ViewData["Title"] = "Agenda";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="page-header mb-0">
        <div class="page-title">Agenda</div>
        <div class="page-sub">Calendário de atendimentos</div>
    </div>
    <a href="@Url.Action("Novo")" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Novo Agendamento
    </a>
</div>

<div class="d-flex gap-3 mb-3" style="font-size:12px;color:#64748b;">
    <span><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#f59e0b;margin-right:4px;"></span>Agendado</span>
    <span><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#16a34a;margin-right:4px;"></span>Sinal pago</span>
    <span><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#2563eb;margin-right:4px;"></span>Concluído</span>
</div>

<div class="section-card mb-4">
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">Filtrar por Profissional</label>
            <select id="profissionalFiltro" class="form-select">
                <option value="">Todos</option>
                @foreach (var p in ViewBag.Profissionais)
                {
                    <option value="@p.Value">@p.Text</option>
                }
            </select>
        </div>
    </div>
</div>

<div class="section-card">
    <div id="calendar"></div>
</div>

<!-- MODAL DETALHES -->
<div class="modal fade" id="modalDetalhes" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Detalhes do Agendamento</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalDetalhesBody">
                <div class="text-center py-3"><div class="spinner-border text-primary"></div></div>
            </div>
            <div class="modal-footer border-0 d-flex gap-2 flex-wrap" id="modalDetalhesBtns"></div>
        </div>
    </div>
</div>

<!-- MODAL CANCELAR -->
<div class="modal fade" id="modalCancelar" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white border-0"><h5>Cancelar agendamento</h5></div>
            <div class="modal-body text-center">
                <p>Deseja cancelar este agendamento?</p>
                <input type="hidden" id="cancelarId" />
            </div>
            <div class="modal-footer border-0">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Voltar</button>
                <button class="btn btn-danger" id="btnCancelarConfirm">Confirmar cancelamento</button>
            </div>
        </div>
    </div>
</div>

<!-- TOAST -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="toast" class="toast align-items-center text-white border-0">
        <div class="d-flex align-items-center">
            <div id="toastMsg" class="toast-body"></div>
            <button class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<link href="https://cdn.jsdelivr.net/npm/fullcalendar@@6.1.11/index.global.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@@6.1.11/index.global.min.js"></script>

<script>
    let modalDetalhes, modalCancelar, calendar;

    document.addEventListener('DOMContentLoaded', function () {
        modalDetalhes = new bootstrap.Modal(document.getElementById('modalDetalhes'));
        modalCancelar = new bootstrap.Modal(document.getElementById('modalCancelar'));

        calendar = new FullCalendar.Calendar(document.getElementById('calendar'), {
            initialView: 'timeGridWeek',
            locale: 'pt-br',
            height: 680,
            slotMinTime: '07:00:00',
            slotMaxTime: '21:00:00',
            allDaySlot: false,
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,timeGridDay'
            },
            events: function (info, successCallback, failureCallback) {
                let profId = document.getElementById('profissionalFiltro').value;
                fetch(`/Agendamento/ListarEventos?profissionalId=${profId}`)
                    .then(r => r.json())
                    .then(data => successCallback(data))
                    .catch(err => failureCallback(err));
            },
            eventClick: function (info) {
                abrirDetalhes(info.event.id);
            }
        });

        calendar.render();
        document.getElementById('profissionalFiltro').addEventListener('change', () => calendar.refetchEvents());
    });

    function getToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    }

    function toast(msg, tipo) {
        let t = document.getElementById('toast');
        t.className = 'toast align-items-center text-white border-0 ' + tipo;
        document.getElementById('toastMsg').textContent = msg;
        new bootstrap.Toast(t, { delay: 4000 }).show();
    }

    function abrirDetalhes(id) {
        document.getElementById('modalDetalhesBody').innerHTML =
            '<div class="text-center py-3"><div class="spinner-border text-primary"></div></div>';
        document.getElementById('modalDetalhesBtns').innerHTML = '';
        modalDetalhes.show();

        fetch(`/Agendamento/Detalhes?id=${id}`)
            .then(r => r.json())
            .then(d => {
                const badgeMap = { Agendado:'bg-warning text-dark', Confirmado:'bg-success', Concluido:'bg-primary', Cancelado:'bg-secondary' };
                const badge = badgeMap[d.status] || 'bg-secondary';

                const servicosHtml = d.servicos.map(s =>
                    `<li class="d-flex justify-content-between py-1 border-bottom">
                        <span style="font-size:13px;">${s.nome}</span>
                        <strong style="font-size:13px;">R$ ${s.valor.toFixed(2)}</strong>
                    </li>`
                ).join('');

                document.getElementById('modalDetalhesBody').innerHTML = `
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge ${badge} px-3 py-2" style="font-size:12px;">${d.status}</span>
                        <small class="text-muted">#${d.id}</small>
                    </div>
                    <div style="font-weight:600;font-size:15px;">${d.cliente}</div>
                    <div style="color:#64748b;font-size:13px;margin-top:2px;">
                        <i class="bi bi-person-badge me-1"></i>${d.profissional}
                    </div>
                    <div style="color:#64748b;font-size:13px;margin-top:2px;margin-bottom:16px;">
                        <i class="bi bi-clock me-1"></i>${d.dataHora} — ${d.dataFim}
                    </div>
                    <ul class="list-unstyled mb-3">${servicosHtml}</ul>
                    <div class="d-flex justify-content-between fw-bold py-2" style="font-size:14px;">
                        <span>Total dos serviços</span>
                        <span style="color:#16a34a;">R$ ${d.valorTotal.toFixed(2)}</span>
                    </div>
                    <hr/>
                    <div style="font-size:12px;color:#64748b;margin-bottom:6px;font-weight:600;text-transform:uppercase;letter-spacing:.5px;">Pagamento</div>
                    <div class="d-flex gap-2 flex-wrap">
                        <span class="badge ${d.sinalPago ? 'bg-success-soft' : 'bg-warning-soft'}">
                            ${d.sinalPago ? '✓' : '○'} Sinal — R$ ${d.valorSinal.toFixed(2)}
                        </span>
                        <span class="badge ${d.restantePago ? 'bg-success-soft' : 'bg-warning-soft'}">
                            ${d.restantePago ? '✓' : '○'} Restante — R$ ${d.valorRestante.toFixed(2)}
                        </span>
                    </div>
                `;

                // Botões de ação por status
                let btns = document.getElementById('modalDetalhesBtns');
                btns.innerHTML = '';

                if (d.status === 'Agendado') {
                    btns.innerHTML += `
                        <button class="btn btn-success" onclick="registrarSinal(${d.id})">
                            <i class="bi bi-cash-coin"></i> Receber Sinal (R$ ${d.valorSinal.toFixed(2)})
                        </button>`;
                }
                if (d.status === 'Confirmado') {
                    btns.innerHTML += `
                        <button class="btn btn-primary" onclick="concluir(${d.id})">
                            <i class="bi bi-check-circle"></i> Concluir (R$ ${d.valorRestante.toFixed(2)})
                        </button>`;
                }
                if (d.status !== 'Concluido' && d.status !== 'Cancelado') {
                    btns.innerHTML += `
                        <button class="btn btn-outline-danger" onclick="abrirCancelar(${d.id})">
                            Cancelar
                        </button>`;
                }
                btns.innerHTML += `<button class="btn btn-light ms-auto" data-bs-dismiss="modal">Fechar</button>`;
            })
            .catch(() => {
                document.getElementById('modalDetalhesBody').innerHTML =
                    '<p class="text-danger">Erro ao carregar detalhes.</p>';
            });
    }

    function registrarSinal(id) {
        let fd = new FormData();
        fd.append('id', id);
        fd.append('__RequestVerificationToken', getToken());
        fetch('/Agendamento/RegistrarSinal', { method: 'POST', body: fd })
            .then(r => r.json())
            .then(data => {
                if (data.success) { modalDetalhes.hide(); calendar.refetchEvents(); toast(data.msg, 'bg-success'); }
                else { toast(data.msg, 'bg-danger'); }
            });
    }

    function concluir(id) {
        let fd = new FormData();
        fd.append('id', id);
        fd.append('__RequestVerificationToken', getToken());
        fetch('/Agendamento/Concluir', { method: 'POST', body: fd })
            .then(r => r.json())
            .then(data => {
                if (data.success) { modalDetalhes.hide(); calendar.refetchEvents(); toast(data.msg, 'bg-success'); }
                else { toast(data.msg, 'bg-danger'); }
            });
    }

    function abrirCancelar(id) {
        document.getElementById('cancelarId').value = id;
        modalDetalhes.hide();
        setTimeout(() => modalCancelar.show(), 300);
    }

    document.getElementById('btnCancelarConfirm').addEventListener('click', function () {
        let id  = document.getElementById('cancelarId').value;
        let btn = this;
        btn.disabled = true; btn.textContent = 'Cancelando...';
        let fd = new FormData();
        fd.append('id', id);
        fd.append('__RequestVerificationToken', getToken());
        fetch('/Agendamento/Cancelar', { method: 'POST', body: fd })
            .then(r => r.json())
            .then(data => {
                if (data.success) { modalCancelar.hide(); calendar.refetchEvents(); toast('Agendamento cancelado', 'bg-warning'); }
                else { toast('Erro ao cancelar', 'bg-danger'); }
            })
            .finally(() => { btn.disabled = false; btn.textContent = 'Confirmar cancelamento'; });
    });
</script>

@Html.AntiForgeryToken()
