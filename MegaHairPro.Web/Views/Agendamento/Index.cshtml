@{
    ViewData["Title"] = "Agenda";
}

<div class="page-header">
    <div>
        <div class="page-title">Agenda</div>
        <div class="page-sub">Visualize e gerencie todos os agendamentos</div>
    </div>
    <a href="@Url.Action("Novo")" class="btn-header-action">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
        Novo Agendamento
    </a>
</div>

<!-- FILTRO -->
<div class="section-card">
    <div class="section-label">Filtros</div>
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Profissional</label>
            <select id="profissionalFiltro" class="form-select">
                <option value="">Todos os profissionais</option>
                @foreach (var p in ViewBag.Profissionais)
                {
                    <option value="@p.Value">@p.Text</option>
                }
            </select>
        </div>
    </div>
</div>

<!-- CALENDÁRIO -->
<div class="section-card">
    <div id="calendar"></div>
</div>

<!-- MODAL DETALHES -->
<div class="modal fade" id="modalDetalhes" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:16px;overflow:hidden">
            <div class="modal-header border-0" style="background:var(--navy,#1a2e4a);color:#fff;padding:20px 24px">
                <h5 class="modal-title" style="font-weight:600;font-size:1rem">Detalhes do Agendamento</h5>
                <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4" id="modalDetalhesBody">
                <div class="text-center py-3">
                    <div class="spinner-border" style="color:var(--navy,#1a2e4a)"></div>
                </div>
            </div>
            <div class="modal-footer border-0 px-4 pb-4 pt-0 gap-2">
                <button class="btn btn-light" data-bs-dismiss="modal">Fechar</button>
                <button class="btn btn-danger" id="btnCancelarAgendamento">Cancelar Agendamento</button>
            </div>
        </div>
    </div>
</div>

<!-- TOAST -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="toast" class="toast align-items-center text-white border-0">
        <div class="d-flex align-items-center">
            <div id="toastMsg" class="toast-body"></div>
            <button class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<link href="https://cdn.jsdelivr.net/npm/fullcalendar@@6.1.11/index.global.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@@6.1.11/index.global.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@@6.1.11/locales/pt-br.global.min.js"></script>

<style>
    .fc { font-family: inherit; }
    .fc .fc-toolbar-title { font-size: 1rem; font-weight: 600; }
    .fc .fc-button { background: var(--navy,#1a2e4a) !important; border-color: var(--navy,#1a2e4a) !important; font-size: 0.8rem; border-radius: 6px !important; }
    .fc .fc-button:hover { opacity: .85; }
    .fc .fc-button-active { opacity: .7 !important; }
    .fc-event { border-radius: 6px !important; font-size: 0.78rem !important; border: none !important; padding: 2px 6px !important; }
    .fc-timegrid-slot { height: 40px !important; }
    .detail-row { display:flex; justify-content:space-between; padding: 8px 0; border-bottom: 1px solid #f0f0f0; font-size:.9rem; }
    .detail-row:last-child { border-bottom:none; }
    .detail-label { color: #6b7280; }
    .detail-value { font-weight: 500; }
</style>

<script>
    let modalDetalhes, agendamentoAtivoId = null, calendar;

    document.addEventListener('DOMContentLoaded', function () {
        modalDetalhes = new bootstrap.Modal(document.getElementById('modalDetalhes'));
        var calendarEl = document.getElementById('calendar');
        calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'timeGridWeek',
            locale: 'pt-br',
            height: 680,
            slotMinTime: '07:00:00',
            slotMaxTime: '21:00:00',
            allDaySlot: false,
            headerToolbar: { left: 'prev,next today', center: 'title', right: 'dayGridMonth,timeGridWeek,timeGridDay' },
            buttonText: { today: 'Hoje', month: 'Mês', week: 'Semana', day: 'Dia' },
            events: function (info, successCallback, failureCallback) {
                let profissionalId = document.getElementById('profissionalFiltro').value;
                fetch(`/Agendamento/ListarEventos?profissionalId=${profissionalId}`)
                    .then(r => r.json()).then(data => successCallback(data)).catch(err => failureCallback(err));
            },
            eventClick: function (info) { agendamentoAtivoId = info.event.id; abrirDetalhes(info.event.id); }
        });
        calendar.render();
        document.getElementById('profissionalFiltro').addEventListener('change', () => calendar.refetchEvents());
    });

    function abrirDetalhes(id) {
        document.getElementById('modalDetalhesBody').innerHTML = '<div class="text-center py-3"><div class="spinner-border" style="color:var(--navy,#1a2e4a)"></div></div>';
        modalDetalhes.show();
        fetch(`/Agendamento/Detalhes?id=${id}`)
            .then(r => r.json())
            .then(d => {
                let servicosHtml = d.servicos.map(s => `
                    <div class="d-flex justify-content-between align-items-center py-2" style="border-bottom:1px solid #f3f4f6">
                        <span style="font-size:.88rem">${s.nome}</span>
                        <span class="fw-600" style="color:#16a34a;font-size:.88rem">R$ ${s.valor.toFixed(2)}</span>
                    </div>`).join('');
                document.getElementById('modalDetalhesBody').innerHTML = `
                    <div class="detail-row"><span class="detail-label">Cliente</span><span class="detail-value">${d.cliente}</span></div>
                    <div class="detail-row"><span class="detail-label">Profissional</span><span class="detail-value">${d.profissional}</span></div>
                    <div class="detail-row"><span class="detail-label">Horário</span><span class="detail-value">${d.dataHora} até ${d.dataFim}</span></div>
                    <div class="mt-3 mb-1" style="font-size:.78rem;font-weight:600;text-transform:uppercase;letter-spacing:.5px;color:#9ca3af">Serviços</div>
                    ${servicosHtml}
                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2" style="border-top:2px solid #f3f4f6">
                        <span style="font-weight:600">Total</span>
                        <span style="font-size:1.1rem;font-weight:700;color:#16a34a">R$ ${d.valorTotal.toFixed(2)}</span>
                    </div>`;
            })
            .catch(() => { document.getElementById('modalDetalhesBody').innerHTML = '<p class="text-danger">Erro ao carregar detalhes.</p>'; });
    }

    document.getElementById('btnCancelarAgendamento').addEventListener('click', function () {
        if (!agendamentoAtivoId) return;
        let btn = this;
        btn.disabled = true; btn.textContent = 'Cancelando...';
        let fd = new FormData();
        fd.append('id', agendamentoAtivoId);
        fd.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]')?.value || '');
        fetch('/Agendamento/Cancelar', { method: 'POST', body: fd })
            .then(r => r.json())
            .then(data => {
                if (data.success) { modalDetalhes.hide(); calendar.refetchEvents(); toast('Agendamento cancelado', 'bg-success'); }
                else { toast('Erro ao cancelar', 'bg-danger'); }
            })
            .catch(() => toast('Erro ao cancelar', 'bg-danger'))
            .finally(() => { btn.disabled = false; btn.textContent = 'Cancelar Agendamento'; });
    });

    function toast(msg, tipo) {
        let t = document.getElementById('toast');
        t.className = 'toast align-items-center text-white border-0 ' + tipo;
        document.getElementById('toastMsg').textContent = msg;
        new bootstrap.Toast(t, { delay: 3000 }).show();
    }
</script>
@Html.AntiForgeryToken()
