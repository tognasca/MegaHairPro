@model IEnumerable<MegaHairPro.Web.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<div class="page-header">
    <div class="page-title">Clientes</div>
    <div class="page-sub">Cadastro e gerenciamento de clientes</div>
</div>

<!-- CADASTRO -->
<div class="section-card">
    <div class="section-label">Novo cliente</div>
    <form asp-action="Index" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-3">
            <div class="col-md-5">
                <label class="form-label">Nome</label>
                <input id="newNome" name="Nome" class="form-control" placeholder="Nome completo" />
                @* <div class="invalid-feedback">Informe o nome</div> *@
            </div>
            <div class="col-md-2">
                <label class="form-label">CPF (opcional)</label>
                <input id="newCpf" name="CPF" class="form-control" placeholder="000.000.000-00" />
                @* <div class="invalid-feedback">CPF inválido</div> *@
            </div>
            @* <div class="col-md-2">
                <label class="form-label">Telefone</label>
                <input name="Telefone" class="form-control" placeholder="(00) 0000-0000" />
            </div> *@
            <div class="col-md-2">
                <label class="form-label">WhatsApp</label>
                <input id="newWhats" name="WhatsApp" class="form-control" placeholder="(00) 00000-0000" />
                @* <div class="invalid-feedback">WhatsApp inválido</div> *@
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <button class="btn btn-success w-100">Salvar</button>
            </div>
            <div class="col-md-4">
                <label class="form-label">E-mail</label>
                <input name="Email" type="email" class="form-control" placeholder="email@exemplo.com" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Data Nascimento</label>
                <input name="DataNascimento" type="date" class="form-control" />
            </div>
           @*  <div class="col-md-6">
                <label class="form-label">Endereço</label>
                <input name="Endereco" class="form-control" placeholder="Rua, número, bairro..." />
            </div> *@
            <div class="col-md-12">
                <label class="form-label">Observações</label>
                <textarea name="Observacoes" class="form-control" rows="2" placeholder="Informações adicionais..."></textarea>
            </div>
        </div>
    </form>
</div>

<!-- LISTAGEM -->
<div class="table-card">
    <div class="table-card-header">
        <span class="table-card-title">Clientes registrados</span>
        <span class="table-count">@Model.Count() registros</span>
    </div>
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>CPF</th>
                    @* <th>Telefone</th> *@
                    <th>WhatsApp</th>
                    <th>E-mail</th>
                    <th>Status</th>
                    <th width="220"></th>
                </tr>
            </thead>
            <tbody id="clientesBody">
                @foreach (var c in Model)
                {
                    @Html.Partial("_ClienteRow", c)
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL EDITAR -->
<div class="modal fade" id="modalEditarCliente" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Editar Cliente</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editId" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nome</label>
                        <input id="editNome" class="form-control" />
                        <div class="invalid-feedback">Informe o nome</div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Telefone</label>
                        <input id="editTelefone" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">WhatsApp</label>
                        <input id="editWhats" class="form-control" />
                        <div class="invalid-feedback">WhatsApp inválido</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">E-mail</label>
                        <input id="editEmail" type="email" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">CPF (opcional)</label>
                        <input id="editCpf" class="form-control" />
                        <div class="invalid-feedback">CPF inválido</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Nascimento</label>
                        <input id="editNascimento" type="date" class="form-control" />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">Endereço</label>
                        <input id="editEndereco" class="form-control" />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">Observações</label>
                        <textarea id="editObs" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-success px-4" onclick="salvarEdicao()">Salvar</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL EXCLUIR -->
<div class="modal fade" id="modalExcluir" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white border-0">
                <h5>Confirmar exclusão</h5>
            </div>
            <div class="modal-body text-center">
                <p>Deseja excluir este cliente?</p>
                <input type="hidden" id="excluirId" />
            </div>
            <div class="modal-footer border-0">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-danger" id="btnExcluir">Excluir</button>
            </div>
        </div>
    </div>
</div>

<!-- TOAST -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="toast" class="toast align-items-center text-white border-0">
        <div class="d-flex align-items-center">
            <div id="toastMsg" class="toast-body"></div>
            <button class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/cleave.js@1.6.0/dist/cleave.min.js"></script>
<script>
    let modalEditar, modalExcluir;

    document.addEventListener("DOMContentLoaded", function () {
        modalEditar  = new bootstrap.Modal(document.getElementById("modalEditarCliente"));
        modalExcluir = new bootstrap.Modal(document.getElementById("modalExcluir"));
        // validar cadastro antes de enviar
        let formCadastro = document.querySelector('form[asp-action="Index"]');
        if (formCadastro) formCadastro.addEventListener('submit', validarCadastro);
        // preserve default invalid-feedback texts
        document.querySelectorAll('.invalid-feedback').forEach(function (fb) { if (!fb.getAttribute('data-default')) fb.setAttribute('data-default', fb.textContent); });
        attachMasks();
        // show server-side validation error (if any)
        let serverError = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Error"] ?? ""));
        if (serverError) {
            try { serverError = JSON.parse(serverError); } catch (e) { }
            if (serverError) {
                toast(serverError, 'bg-danger');
                let se = String(serverError).toLowerCase();
                if (se.includes('nome')) { let el = document.getElementById('newNome'); if (el) showInvalid(el, 'Informe o nome'); }
                if (se.includes('cpf'))  { let el = document.getElementById('newCpf'); if (el) showInvalid(el, 'CPF inválido'); }
                if (se.includes('whatsapp')) { let el = document.getElementById('newWhats'); if (el) showInvalid(el, 'WhatsApp inválido'); }
            }
        }
    });

    function getToken() {
        return $('input[name="__RequestVerificationToken"]').first().val();
    }

    function toast(msg, tipo) {
        let t = $("#toast");
        t.removeClass("bg-success bg-danger bg-warning");
        t.addClass(tipo);
        $("#toastMsg").text(msg);
        new bootstrap.Toast(t[0], { delay: 3000 }).show();
    }

    function onlyDigits(s) {
        return s ? s.replace(/\D/g, '') : '';
    }

    // form feedback helpers
    function showInvalid(el, msg) {
        if (!el) return;
        el.classList.add('is-invalid');
        let fb = el.nextElementSibling;
        if (fb && fb.classList.contains('invalid-feedback') && msg) fb.textContent = msg;
    }
    function clearInvalid(el) {
        if (!el) return;
        el.classList.remove('is-invalid');
        let fb = el.nextElementSibling;
        if (fb && fb.classList.contains('invalid-feedback')) fb.textContent = fb.getAttribute('data-default') || fb.textContent;
    }

    // CPF verifier (calculate check digits)
    function isValidCPF(cpf) {
        let d = onlyDigits(cpf);
        if (d.length !== 11) return false;
        // invalid repeated sequences
        if (/^(\d)\1{10}$/.test(d)) return false;
        let nums = d.split('').map(Number);
        // first verifier
        let sum = 0;
        for (let i = 0; i < 9; i++) sum += nums[i] * (10 - i);
        let r = (sum * 10) % 11;
        if (r === 10) r = 0;
        if (r !== nums[9]) return false;
        // second verifier
        sum = 0;
        for (let i = 0; i < 10; i++) sum += nums[i] * (11 - i);
        r = (sum * 10) % 11;
        if (r === 10) r = 0;
        return r === nums[10];
    }

    // initialize Cleave.js masks for CPF and WhatsApp
    function attachMasks() {
        try {
            // CPF: 000.000.000-00
            if (document.getElementById('newCpf')) new Cleave('#newCpf', { numericOnly: true, blocks: [3, 3, 3, 2], delimiters: ['.', '.', '-'] });
            if (document.getElementById('editCpf')) new Cleave('#editCpf', { numericOnly: true, blocks: [3, 3, 3, 2], delimiters: ['.', '.', '-'] });

            // WhatsApp / phone (Brazil)
            if (document.getElementById('newWhats')) new Cleave('#newWhats', { phone: true, phoneRegionCode: 'BR' });
            if (document.getElementById('editWhats')) new Cleave('#editWhats', { phone: true, phoneRegionCode: 'BR' });
        } catch (e) {
            console.warn('Cleave.js not available, falling back to basic masks');
        }
    }


    // function validarCadastro(e) {
    //     // campos do formulário de cadastro (seleciona por name)
    //     let nomeEl = document.querySelector('input[name="Nome"]');
    //     let cpfEl = document.querySelector('input[name="CPF"]');
    //     let whatsEl = document.querySelector('input[name="WhatsApp"]');

    //     // remover marcações anteriores
    //     [nomeEl, cpfEl, whatsEl].forEach(function (el) { if (el) el.classList.remove('is-invalid'); });

    //     let nome = nomeEl ? nomeEl.value.trim() : '';
    //     let cpf = cpfEl ? cpfEl.value.trim() : '';
    //     let whats = whatsEl ? whatsEl.value.trim() : '';

    //     if (!nome) { if (nomeEl) nomeEl.classList.add('is-invalid'); toast('Informe o nome', 'bg-danger'); e.preventDefault(); if (nomeEl) nomeEl.focus(); return false; }

    //     // validar CPF com algoritmo
    //     if (!cpf)  { if (cpfEl) showInvalid(cpfEl, 'Informe o CPF'); toast('Informe o CPF', 'bg-danger'); e.preventDefault(); if (cpfEl) cpfEl.focus(); return false; }
    //     if (!isValidCPF(cpf)) { if (cpfEl) showInvalid(cpfEl, 'CPF inválido'); toast('CPF inválido', 'bg-danger'); e.preventDefault(); if (cpfEl) cpfEl.focus(); return false; }

    //     // validar WhatsApp (10 ou 11 dígitos: DDD + número)
    //     let whatsDigits = onlyDigits(whats);
    //     if (!whats){ if (whatsEl) showInvalid(whatsEl, 'Informe o WhatsApp'); toast('Informe o WhatsApp', 'bg-danger'); e.preventDefault(); if (whatsEl) whatsEl.focus(); return false; }
    //     if (whatsDigits.length < 10 || whatsDigits.length > 11) { if (whatsEl) showInvalid(whatsEl, 'WhatsApp inválido'); toast('WhatsApp inválido', 'bg-danger'); e.preventDefault(); if (whatsEl) whatsEl.focus(); return false; }

    //     return true;
    // }

    function validarCadastro(e) {
    // Nenhuma validação obrigatória — apenas limpa marcações anteriores
    let nomeEl  = document.querySelector('input[name="Nome"]');
    let cpfEl   = document.querySelector('input[name="CPF"]');
    let whatsEl = document.querySelector('input[name="WhatsApp"]');

    [nomeEl, cpfEl, whatsEl].forEach(function (el) {
    if (el) el.classList.remove('is-invalid');
    });

    // Validação opcional de CPF (somente se preenchido)
    let cpf = cpfEl ? cpfEl.value.trim() : '';
    if (cpf && !isValidCPF(cpf)) {
    showInvalid(cpfEl, 'CPF inválido');
    toast('CPF inválido', 'bg-danger');
    e.preventDefault();
    cpfEl.focus();
    return false;
    }

    // Validação opcional de WhatsApp (somente se preenchido)
    let whats = whatsEl ? whatsEl.value.trim() : '';
    let whatsDigits = onlyDigits(whats);
    if (whats && (whatsDigits.length < 10 || whatsDigits.length > 11)) {
    showInvalid(whatsEl, 'WhatsApp inválido');
    toast('WhatsApp inválido', 'bg-danger');
    e.preventDefault();
    whatsEl.focus();
    return false;
    }

    return true;
    }

    function val(row, key) {
        return row.dataset[key] || "";
    }

    function editarCliente(id) {
        let row = document.getElementById("row-" + id);
        document.getElementById("editId").value         = id;
        document.getElementById("editNome").value       = val(row, "nome");
        document.getElementById("editTelefone").value   = val(row, "telefone");
        document.getElementById("editWhats").value      = val(row, "whatsapp");
        document.getElementById("editEmail").value      = val(row, "email");
        document.getElementById("editCpf").value        = val(row, "cpf");
        document.getElementById("editNascimento").value = val(row, "nascimento");
        document.getElementById("editEndereco").value   = val(row, "endereco");
        document.getElementById("editObs").value        = val(row, "obs");
        modalEditar.show();
    }

    function salvarEdicao() {
        // validar campos obrigatórios antes de enviar
        let id = document.getElementById("editId").value;
        let nome = document.getElementById("editNome").value.trim();
        let cpf = document.getElementById("editCpf").value.trim();
        let whats = document.getElementById("editWhats").value.trim();

        // remover marcações anteriores
        ["editNome", "editCpf", "editWhats"].forEach(function (i) {
            let el = document.getElementById(i);
            if (el) el.classList.remove("is-invalid");
        });

        if (!nome) { document.getElementById("editNome").classList.add("is-invalid"); toast("Informe o nome", "bg-danger"); document.getElementById("editNome").focus(); return; }

        // CPF opcional: validar somente quando informado
        if (cpf && !isValidCPF(cpf)) {
            showInvalid(document.getElementById("editCpf"), 'CPF inválido');
            toast("CPF inválido", "bg-danger");
            document.getElementById("editCpf").focus();
            return;
        }

        // validar WhatsApp (10 ou 11 dígitos)
        let whatsDigits = onlyDigits(whats);
        if (!whats){ showInvalid(document.getElementById("editWhats"), 'Informe o WhatsApp'); toast("Informe o WhatsApp", "bg-danger"); document.getElementById("editWhats").focus(); return; }
        if (whatsDigits.length < 10 || whatsDigits.length > 11) { showInvalid(document.getElementById("editWhats"), 'WhatsApp inválido'); toast("WhatsApp inválido", "bg-danger"); document.getElementById("editWhats").focus(); return; }

        let fd = new FormData();
        fd.append("Id",             id);
        fd.append("Nome",           nome);
        fd.append("Telefone",       document.getElementById("editTelefone").value);
        fd.append("WhatsApp",       whats);
        fd.append("Email",          document.getElementById("editEmail").value);
        fd.append("CPF",            cpf);
        fd.append("DataNascimento", document.getElementById("editNascimento").value);
        fd.append("Endereco",       document.getElementById("editEndereco").value);
        fd.append("Observacoes",    document.getElementById("editObs").value);
        fd.append("__RequestVerificationToken", getToken());

        $.ajax({
            url: "/Clientes/EditAjax", type: "POST", data: fd,
            processData: false, contentType: false,
            success: function (res) {
                if (res && res.html) $("#row-" + id).replaceWith(res.html);
                modalEditar.hide();
                toast((res && res.message) || "Cliente editado com sucesso", "bg-success");
            },
            error: function (xhr) {
                var msg = "Erro ao editar";
                try { if (xhr && xhr.responseText) msg = xhr.responseText; } catch (e) { }
                toast(msg, "bg-danger");
                var m = String(msg).toLowerCase();
                if (m.includes('nome')) showInvalid(document.getElementById('editNome'), 'Informe o nome');
                if (m.includes('cpf')) showInvalid(document.getElementById('editCpf'), 'CPF inválido');
                if (m.includes('whatsapp')) showInvalid(document.getElementById('editWhats'), 'WhatsApp inválido');
            }
        });
    }

    function toggleStatus(id) {
        let fd = new FormData();
        fd.append("id", id);
        fd.append("__RequestVerificationToken", getToken());

        $.ajax({
            url: "/Clientes/ToggleStatusAjax", type: "POST", data: fd,
            processData: false, contentType: false,
            success: function (res) {
                if (res && res.html) $("#row-" + id).replaceWith(res.html);
                toast("Status alterado", "bg-warning");
            },
            error: function () { toast("Erro ao alterar status", "bg-danger"); }
        });
    }

    function confirmarExcluir(id) {
        $("#excluirId").val(id);
        modalExcluir.show();
    }

    $("#btnExcluir").click(function () {
        let id  = $("#excluirId").val();
        let btn = $(this).html("Excluindo...").prop("disabled", true);

        let fd = new FormData();
        fd.append("id", id);
        fd.append("__RequestVerificationToken", getToken());

        $.ajax({
            url: "/Clientes/Delete", type: "POST", data: fd,
            processData: false, contentType: false,
            success: function () {
                $("#row-" + id).fadeOut(300, function () { $(this).remove(); });
                modalExcluir.hide();
                toast("Cliente excluído", "bg-success");
            },
            error: function () { toast("Erro ao excluir", "bg-danger"); },
            complete: function () { btn.html("Excluir").prop("disabled", false); }
        });
    });
</script>
