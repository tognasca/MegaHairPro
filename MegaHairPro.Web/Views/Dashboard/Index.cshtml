@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <div class="page-title">Dashboard</div>
    <div class="page-sub">Visão geral da plataforma — @DateTime.Now.ToString("dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("pt-BR"))</div>
</div>

<!-- MÉTRICAS -->
<div class="row g-3 mb-4">

    <div class="col-6 col-md-3">
        <div class="section-card h-100 mb-0">
            <div class="section-label">Vendas Hoje</div>
            <div class="metric-value text-primary">R$ @ViewBag.TotalHoje.ToString("N2")</div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="section-card h-100 mb-0">
            <div class="section-label">Lucro Hoje</div>
            <div class="metric-value text-success">R$ @ViewBag.LucroHoje.ToString("N2")</div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="section-card h-100 mb-0">
            <div class="section-label">Comissões Pendentes</div>
            <div class="metric-value text-danger">R$ @ViewBag.ComissoesPendentes.ToString("N2")</div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="section-card h-100 mb-0">
            <div class="section-label">Estoque Baixo</div>
            <div class="metric-value text-warning">@ViewBag.EstoqueBaixo</div>
        </div>
    </div>

</div>

<!-- AÇÕES RÁPIDAS -->
<div class="section-card">
    <div class="section-label">Ações Rápidas</div>
    <div class="d-flex gap-2 flex-wrap">
        <a href="/Simulacao/index" class="btn-act btn-act-blue">➕ Nova Simulação</a>
        <a href="/Venda/index" class="btn-act btn-act-green">📌 Vendas Realizadas</a>
        <a href="/Comissao/index" class="btn-act btn-act-red">💰 Comissões Pendentes</a>
        <a href="/Compras/index" class="btn-act btn-act-warn">📦 Estoque</a>
    </div>
</div>

<!-- ESTILO LOCAL -->
<style>
    .metric-value {
        font-size: 1.75rem;
        font-weight: 700;
        margin-top: 6px;
        letter-spacing: -0.5px;
    }
</style>
