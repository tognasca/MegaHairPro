@model IEnumerable<MegaHairPro.Web.Models.Despesas>

<div class="container-fluid">


    <!-- DASHBOARD -->

    <div class="row mb-4">

        <div class="col-md-4">

            <div class="card-premium">

                <small>Total do mês</small>

                <h3 class="text-danger">

                    R$ @Model.Sum(x => x.Valor).ToString("N2")

                </h3>

            </div>

        </div>

    </div>



    <!-- NOVA DESPESA -->

    <div class="card-premium mb-4">

        <h5>➕ Nova Despesa</h5>

        @Html.AntiForgeryToken()

        <div class="row g-2">


            <div class="col-md-2">

                <select id="categoria" class="form-select">

                    <option value="">Categoria</option>

                    <option>Salão</option>
                    <option>Aluguel</option>
                    <option>Internet</option>
                    <option>Produto</option>
                    <option>Marketing</option>

                </select>

            </div>



            <div class="col-md-3">

                <input id="descricao"
                       class="form-control"
                       placeholder="Descrição">

            </div>



            <div class="col-md-2">

                <input id="valor"
                       type="number"
                       class="form-control"
                       placeholder="Valor">

            </div>



            <div class="col-md-2">

                <input id="data"
                       type="date"
                       class="form-control">

            </div>



            <div class="col-md-1 form-check mt-2">

                <input type="checkbox"
                       id="ratear"
                       class="form-check-input">

                <label>Ratear</label>

            </div>



            <div class="col-md-2">

                <button id="btnSalvar"
                        class="btn btn-success w-100"
                        onclick="salvarDespesa()">

                    Salvar

                </button>

            </div>



        </div>

    </div>




    <!-- TABELA -->

    <div class="card-premium">

        <table class="table table-hover">

            <thead>

                <tr>

                    <th>Categoria</th>
                    <th>Descrição</th>
                    <th>Valor</th>
                    <th>Data</th>
                    <th>Rateio</th>
                    <th width="180"></th>

                </tr>

            </thead>



            <tbody id="lista">

                @foreach (var d in Model)
                {

                    @Html.Partial("_DespesaRow", d)

                }

            </tbody>


        </table>

    </div>

</div>




<!-- MODAL EDITAR -->

<div class="modal fade" id="modalEditar">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">


            <div class="modal-header bg-primary text-white">

                <h5>Editar Despesa</h5>

                <button class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>



            <div class="modal-body">


                <input type="hidden" id="editId">


                <label>Categoria</label>

                <select id="editCategoria"
                        class="form-control mb-2">

                    <option>Salão</option>
                    <option>Aluguel</option>
                    <option>Internet</option>
                    <option>Produto</option>
                    <option>Marketing</option>

                </select>



                <label>Descrição</label>

                <input id="editDescricao"
                       class="form-control mb-2">



                <label>Valor</label>

                <input id="editValor"
                       type="number"
                       class="form-control mb-2">



                <label>Data</label>

                <input id="editData"
                       type="date"
                       class="form-control mb-2">



                <div class="form-check">

                    <input type="checkbox"
                           id="editRatear"
                           class="form-check-input">

                    <label>Ratear</label>

                </div>


            </div>



            <div class="modal-footer">

                <button class="btn btn-success"
                        onclick="salvarEdicao()">

                    Salvar

                </button>

            </div>



        </div>
    </div>
</div>




<!-- TOAST -->

<div class="toast-container position-fixed bottom-0 end-0 p-3">

    <div id="toast"
         class="toast text-white">

        <div id="toastMsg"
             class="toast-body">
        </div>

    </div>

</div>


<div class="modal fade" id="modalExcluir">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <div class="modal-header bg-danger text-white">

                <h5>

                    Confirmar exclusão

                </h5>

            </div>


            <div class="modal-body text-center">

                <h6>

                    Deseja excluir esta Despesa?

                </h6>

                <input type="hidden"
                       id="excluirId">

            </div>



            <div class="modal-footer">

                <button class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Cancelar

                </button>


                <button class="btn btn-danger"
                        id="btnExcluir">

                    Excluir

                </button>

            </div>


        </div>

    </div>

</div>


<script>


    let modalEditar;

     let modalExcluir;

    document.addEventListener("DOMContentLoaded", function(){

    modalEditar =
    new bootstrap.Modal(document.getElementById("modalEditar"));

    document.getElementById("data").valueAsDate =
    new Date();

      modalExcluir =  new bootstrap.Modal(document.getElementById("modalExcluir"));

    });
    function confirmarExcluir(id)
    {

        $("#excluirId").val(id);

        modalExcluir.show();

    }


    $("#btnExcluir").click(function()
    {

        let id = $("#excluirId").val();

        let btn = $(this);

        btn.html("Excluindo...");
        btn.prop("disabled", true);



        let formData = new FormData();

        formData.append("id", id);

        formData.append("__RequestVerificationToken",
            $('input[name="__RequestVerificationToken"]').val());

        $.ajax({

            url: "/Despesas/DeleteAjax",
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,
            success: function()
            {
                let row = $("#row-" + id);
                row.fadeOut(300,function(){
                    row.remove();
                });
                modalExcluir.hide();
                toast("Produto excluído com sucesso","bg-success");
            },
            complete: function()
            {
                btn.html("Excluir");
                btn.prop("disabled", false);
            }
        });
    });




    // TOAST

    function toast(msg,cor){

    let t=$("#toast");

    t.removeClass("bg-success bg-danger");

    t.addClass(cor);

    $("#toastMsg").html(msg);

    new bootstrap.Toast(t[0]).show();

    }




    // SALVAR

    function salvarDespesa(){

    let fd=new FormData();

    fd.append("Categoria",categoria.value);

    fd.append("Descricao",descricao.value);

    fd.append("Valor",valor.value);

    fd.append("DataCadastro",data.value);

    fd.append("Ratear",ratear.checked);

    fd.append("__RequestVerificationToken",

    $('input[name="__RequestVerificationToken"]').val());


    $.ajax({
    url:'/Despesas/CreateAjax',
    type:'POST',
    data:fd,
    processData:false,
    contentType:false,
    success:function(html){
    $("#lista").prepend(html);
    toast("Salvo com sucesso","bg-success");

    limpar();

    }

    });

    }

    // EDITAR ABRIR

    function abrirModalEditar(id,categoria,descricao,valor,data,ratear){
      
    editId.value=id;
    editCategoria.value=categoria;
    editDescricao.value=descricao;
    editValor.value=valor;
    editData.value=data;
    editRatear.checked=ratear;
    modalEditar.show();

    }

    // SALVAR EDIÇÃO

    function salvarEdicao(){

    let fd=new FormData();

    fd.append("Id",editId.value);

    fd.append("Categoria",editCategoria.value);

    fd.append("Descricao",editDescricao.value);

    fd.append("Valor",editValor.value);

    fd.append("DataCadastro",editData.value);

    fd.append("Ratear",editRatear.checked);

    fd.append("__RequestVerificationToken",

    $('input[name="__RequestVerificationToken"]').val());


    $.ajax({

    url:'/Despesas/EditAjax',

    type:'POST',

    data:fd,

    processData:false,

    contentType:false,


    success:function(html){

    $("#row-"+editId.value)

    .replaceWith(html);

    modalEditar.hide();

    toast("Editado com sucesso","bg-success");

    }

    });

    }
    // LIMPAR

    function limpar(){

    descricao.value="";

    valor.value="";

    ratear.checked=false;

    }



</script>