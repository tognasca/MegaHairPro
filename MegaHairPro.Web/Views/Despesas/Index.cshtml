@model IEnumerable<MegaHairPro.Web.Models.Despesas>

@{
    ViewData["Title"] = "Despesas";
}

<h2>💸 Controle de Despesas</h2>

<hr />

<!-- ✅ FORM CADASTRO -->
<div class="card p-3 mb-4">
    <h4>➕ Nova Despesa</h4>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-md-3">
                <label>Categoria</label>
                <select name="Categoria" class="form-control" required>
                    <option value="">Selecione</option>
                    <option>Despesa Salão</option>
                    <option>Produtos</option>
                    <option>Funcionários</option>
                    <option>Marketing</option>
                    <option>Impostos</option>
                    <option>Outros</option>
                </select>
            </div>
            <div class="col-md-6">
                <label>Descrição</label>
                <input name="Descricao"
                       class="form-control"
                       required />
            </div>

            <div class="col-md-2">
                <label>Valor</label>
                <input name="Valor"
                       type="number"
                       step="0.01"
                       class="form-control decimal"
                       required />
            </div>

            <div class="col-md-2">
                <label>Data</label>
                <input name="DataCadastro"
                       type="date"
                       class="form-control"
                       value="@DateTime.Now.ToString("yyyy-MM-dd")"
                       required />
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-success w-100">
                    ✅ Salvar
                </button>
            </div>

        </div>
    </form>
</div>

<hr />

<!-- ✅ LISTAGEM -->
<h4>📋 Despesas Registradas</h4>


<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Categoria</th>
            <th>Descrição</th>
            <th>Valor</th>
            <th>Data</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody id="despesasBody">
        @foreach (var d in Model)
        {
            @Html.Partial("_DespesaRow", d)
        }
    </tbody>
</table>

<!-- ✅ MODAL -->
<div class="modal fade" id="modalEditarDespesa" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">✏️ Editar Despesa</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="editIdDespesa" />
                <div class="mb-2">
                    <label>Categoria</label>
                    <select id="editCategoria" class="form-control" required>
                        <option>Despesa Salão</option>
                        <option>Produtos</option>
                        <option>Funcionários</option>
                        <option>Marketing</option>
                        <option>Impostos</option>
                        <option>Outros</option>
                    </select>
                </div>
                <div class="mb-2">
                    <label>Descrição</label>
                    <input id="editDescricao" class="form-control" />
                </div>

                <div class="mb-2">
                    <label>Valor</label>
                    <input id="editValor"
                           type="number"
                           step="0.01"
                           class="form-control decimal" />
                </div>

                <div class="mb-2">
                    <label>Data</label>
                    <input id="editData"
                           type="date"
                           class="form-control" />
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button class="btn btn-primary"
                        onclick="salvarEdicao()">
                    ✅ Salvar
                </button>
            </div>

        </div>
    </div>
</div>

<!-- ✅ SCRIPT IGUAL COMPRAS -->
<script>
    let modalEditar;

     $('.decimal').maskMoney({
        prefix: 'R$ ',
        allowNegative: false,
        thousands: '.',
        decimal: ',',
        affixesStay: true
    });

    document.addEventListener("DOMContentLoaded", function () {
        modalEditar = new bootstrap.Modal(
            document.getElementById("modalEditarDespesa")
        );
    });

    function editarDespesa(id) {

        let row = document.getElementById("row-" + id);
        document.getElementById("editCategoria").value = row.dataset.categoria;
        document.getElementById("editIdDespesa").value = id;
        document.getElementById("editDescricao").value = row.dataset.descricao;
        document.getElementById("editValor").value = row.dataset.valor;
        document.getElementById("editData").value = row.dataset.data;

        modalEditar.show();
    }


    function salvarEdicao() {

        let id = document.getElementById("editIdDespesa").value;

        fetch("/Despesas/EditAjax", {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body:
                "Id=" + id +
                "&Categoria=" + document.getElementById("editCategoria").value +
                "&Descricao=" + document.getElementById("editDescricao").value +
                "&Valor=" + document.getElementById("editValor").value +
                "&DataCadastro=" + document.getElementById("editData").value
        })
        .then(r => r.text())
        .then(html => {

            document.getElementById("row-" + id).outerHTML = html;

            modalEditar.hide();
        });
    }

    function toggleStatus(id) {

        fetch("/Despesas/ToggleStatusAjax", {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: "id=" + id
        })
        .then(() => location.reload());
    }

    function excluirDespesa(id) {

        if (!confirm("Deseja excluir esta despesa?"))
            return;

        fetch("/Despesas/Delete", {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: "id=" + id
        })
        .then(() => location.reload());
    }
</script>
