@model IEnumerable<MegaHairPro.Web.Models.Despesas>

@{
    ViewData["Title"] = "Despesas";
}

<h2>💸 Controle de Despesas</h2>

<hr />

<form id="formCreate">

    @Html.AntiForgeryToken()
    <div class="card p-3 mb-4">

        <h4>➕ Nova Despesa</h4>

        <div class="row">

            <div class="col-md-3">

                <select name="Categoria" class="form-control" required>
                    <option value="">Categoria</option>
                    <option>Despesa Salão</option>
                    <option>Produtos</option>
                    <option>Funcionários</option>
                    <option>Marketing</option>
                    <option>Impostos</option>
                    <option>Outros</option>
                </select>

            </div>

            <div class="col-md-4">
                <input name="Descricao"
                       class="form-control"
                       placeholder="Descrição"
                       required />
            </div>

            <div class="col-md-2">
                <input name="Valor"
                       type="number"
                       step="0.01"
                       placeholder="Valor"
                       class="form-control"
                       required />
            </div>
            <div class="form-check">

                <input type="checkbox"
                       name="Ratear"
                       value="true"
                       class="form-check-input"
                       id="Ratear">

                <label class="form-check-label" for="Ratear">
                    Ratear
                </label>

            </div>
            <div class="col-md-2">
                <input name="DataCadastro"
                       type="date"
                       class="form-control"
                       value="@DateTime.Now.ToString("yyyy-MM-dd")"
                       required />
            </div>

            <div class="col-md-1">

                <button class="btn btn-success w-100">
                    Salvar
                </button>

            </div>

        </div>

    </div>

</form>


<table class="table table-bordered">

    <thead>
        <tr>
            <th>Categoria</th>
            <th>Descrição</th>
            <th>Valor</th>
            <th>Rateado</th>
            <th>Data</th>
            <th></th>
        </tr>
    </thead>

    <tbody id="despesasBody">

        @foreach (var item in Model)
        {
            @Html.Partial("_DespesaRow", item)
        }

    </tbody>

</table>



<!-- TOAST -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">

    <div id="toast"
         class="toast text-white border-0">

        <div class="d-flex">

            <div id="toastMsg"
                 class="toast-body"></div>

            <button class="btn-close btn-close-white"
                    data-bs-dismiss="toast"></button>

        </div>

    </div>

</div>



<!-- MODAL EDIT -->
<div class="modal fade" id="modalEditar">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-body">

                <input type="hidden" id="editId">

                <input id="editCategoria" class="form-control mb-2">

                <input id="editDescricao" class="form-control mb-2">

                <input id="editValor"
                       type="number"
                       step="0.01"
                       class="form-control mb-2">


                <input type="checkbox" id="editRatear" />



                <input id="editData"
                       type="date"
                       class="form-control">
            </div>

            <div class="modal-footer">

                <button class="btn btn-primary"
                        onclick="salvarEdit()">
                    Salvar
                </button>

            </div>

        </div>

    </div>

</div>



<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>


<script>


       let modal;

    window.onload = function () {

        modal = new bootstrap.Modal(
            document.getElementById("modalEditar")
        );

    };



    function toast(msg, tipo)
    {

    let t = $("#toast");

    t.removeClass("bg-success bg-danger");

    t.addClass(tipo);

    $("#toastMsg").html(msg);

    new bootstrap.Toast(t[0]).show();

    }


       $("#formCreate").submit(function (e)
    {
        e.preventDefault();

        let form = $(this);

        let formData = new FormData(this);

        $.ajax({

            url: '/Despesas/CreateAjax',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,

            success: function (html)
            {
                $("#despesasBody").prepend(html);

                toast("Criado com sucesso", "bg-success");

                form[0].reset();
            }

        });

    });

    function Delete(id)
    {

    if (!confirm("Excluir?")) return;

    $.post("/Despesas/Delete",

    {

    id:id,

    __RequestVerificationToken:
    $('input[name="__RequestVerificationToken"]').val()

    },

    function(r)
    {

    if(r.success)
    {

    $("#row-"+id).fadeOut();

    toast("Excluído com sucesso","bg-success");

    }

    });

    }


        function editarDespesa(id)
    {

        let r = $("#row-" + id);

        $("#editId").val(id);

        $("#editCategoria").val(r.data("categoria"));

        $("#editDescricao").val(r.data("descricao"));

        $("#editValor").val(r.data("valor"));

        $("#editData").val(r.data("data"));

        $("#editRatear").prop("checked", r.data("ratear"));

        let modal = new bootstrap.Modal(
            document.getElementById("modalEditar"));

        modal.show();

    }



    function salvarEdit()
    {

        let formData = new FormData();

        formData.append("Id", $("#editId").val());

        formData.append("Categoria", $("#editCategoria").val());

        formData.append("Descricao", $("#editDescricao").val());

        formData.append("Valor", $("#editValor").val());

        formData.append("DataCadastro", $("#editData").val());

        formData.append("Ratear",
            $("#editRatear").is(":checked"));

        formData.append("__RequestVerificationToken",
            $('input[name="__RequestVerificationToken"]').val());


        $.ajax({

            url: '/Despesas/EditAjax',

            type: 'POST',

            data: formData,

            processData: false,

            contentType: false,

            success: function (html)
            {

                $("#row-" + $("#editId").val())
                    .replaceWith(html);


                let modal =
                    bootstrap.Modal.getInstance(
                        document.getElementById("modalEditar"));

                modal.hide();


                toast("Editado com sucesso", "bg-success");

            }

        });

    }
</script>