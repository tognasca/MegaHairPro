@model MegaHairPro.Web.Models.Despesas

<tr id="row-@Model.Id"
    data-categoria="@Model.Categoria"
    data-descricao="@Model.Descricao"
    data-valor="@Model.Valor"
    data-ratear="@Model.Ratear"
    data-data="@Model.DataCadastro.ToString("yyyy-MM-dd")">

    <td>@Model.Categoria</td>

    <td>@Model.Descricao</td>

    <td>R$ @Model.Valor</td>

    <td>

        @if (Model.Ratear)
        {
            <span class="badge bg-info">
                Sim
            </span>
        }
        else
        {
            <span class="badge bg-secondary">
                Não
            </span>
        }

    </td>

    <td>@Model.DataCadastro.ToShortDateString()</td>

    <td>

        <button onclick="editarDespesa(@Model.Id)"
                class="btn btn-primary btn-sm">

            Editar

        </button>


        <button onclick="Delete(@Model.Id)"
                class="btn btn-danger btn-sm">

            Excluir

        </button>


    </td>

  

</tr>