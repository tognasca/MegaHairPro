@model MegaHairPro.Web.Models.Despesas

<tr id="row-@Model.Id">


<tr id="row-@Model.Id"  class="fade-in">

    <td>
        <span class="categoria-badge">
            <span class="dot @Model.CorCategoria"></span>
            @Model.Categoria
        </span>
    </td>
    <td>

        @Model.Descricao

    </td>


    <td>

        R$ @Model.Valor.ToString("N2")

    </td>


    <td>

        @Model.DataCadastro.ToString("dd-MM-yyyy")

    </td>


    <td>

        @if (Model.Ratear)
        {
            <span class="badge bg-info">
                Sim
            </span>
        }
        else
        {
            <span class="badge bg-secondary">
                Não
            </span>
        }

    </td>


    <td>

        <button class="btn btn-sm btn-outline-primary"
                onclick="abrirModalEditar(

'@Model.Id',

'@Model.Categoria',

'@Model.Descricao',

'@Model.Valor',

'@Model.DataCadastro.ToString("yyyy-MM-dd")',

@Model.Ratear.ToString().ToLower()

)">

            Editar

        </button>



        <button class="btn btn-sm btn-outline-danger"
                onclick="confirmarExcluir(@Model.Id)">

            Excluir

        </button>

    </td>


</tr>