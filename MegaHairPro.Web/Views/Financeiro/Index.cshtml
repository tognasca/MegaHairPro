@model IEnumerable<MegaHairPro.Web.Models.ContaFinanceira>

@{
    ViewData["Title"] = "Financeiro";
}

<h2 class="mb-4">💰 Financeiro</h2>

<div class="card-premium mb-4">
    <form method="get" class="row g-3">
        <div class="col-md-3">
            <label>Início</label>
            <input type="date"
                   name="inicio"
                   class="form-control"
                   value="@ViewBag.Inicio" />
        </div>
        <div class="col-md-3">
            <label>Fim</label>
            <input type="date"
                   name="fim"
                   class="form-control"
                   value="@ViewBag.Fim" />
        </div>
        <div class="col-md-3 align-self-end">
            <button class="btn btn-primary w-100">
                Filtrar
            </button>
        </div>
    </form>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm p-3 rounded-4">
            <h6 class="text-muted">Entradas (pagas)</h6>
            <h3 class="fw-bold text-success">
                R$ @((decimal)ViewBag.TotalEntradas).ToString("N2")
            </h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm p-3 rounded-4">
            <h6 class="text-muted">Saídas (pagas)</h6>
            <h3 class="fw-bold text-danger">
                R$ @((decimal)ViewBag.TotalSaidas).ToString("N2")
            </h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm p-3 rounded-4">
            <h6 class="text-muted">Saldo</h6>
            <h3 class="fw-bold @( ((decimal)ViewBag.Saldo) >= 0 ? "text-success" : "text-danger")">
                R$ @((decimal)ViewBag.Saldo).ToString("N2")
            </h3>
        </div>
    </div>
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Data</th>
            <th>Tipo</th>
            <th>Origem</th>
            <th>Descrição</th>
            <th class="text-end">Valor</th>
            <th>Status</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.DataCompetencia.ToString("dd/MM/yyyy")</td>
                <td>
                    @if (c.Tipo == MegaHairPro.Web.Models.TipoContaFinanceira.Receber)
                    {
                        <span class="badge bg-success">Receber</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Pagar</span>
                    }
                </td>
                <td>@c.Origem</td>
                <td>@c.Descricao</td>
                <td class="text-end">R$ @c.Valor.ToString("N2")</td>
                <td>
                    @switch (c.Status)
                    {
                        case MegaHairPro.Web.Models.StatusContaFinanceira.Aberta:
                            <span class="badge bg-warning text-dark">Em aberto</span>
                            break;
                        case MegaHairPro.Web.Models.StatusContaFinanceira.Paga:
                            <span class="badge bg-success">Paga</span>
                            break;
                        case MegaHairPro.Web.Models.StatusContaFinanceira.Cancelada:
                            <span class="badge bg-secondary">Cancelada</span>
                            break;
                    }
                </td>
                <td>
                    @if (c.Status == MegaHairPro.Web.Models.StatusContaFinanceira.Aberta)
                    {
                        <form asp-action="MarcarComoPago"
                              method="post"
                              class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@c.Id" />
                            <button class="btn btn-sm btn-success">
                                Marcar pago
                            </button>
                        </form>

                        <form asp-action="Cancelar"
                              method="post"
                              class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@c.Id" />
                            <button class="btn btn-sm btn-outline-danger">
                                Cancelar
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

