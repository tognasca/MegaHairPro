@model MegaHairPro.Web.Models.Fornecedor

<tr id="row-@Model.Id"
    data-nome="@(Model.Nome ?? "")"
    data-contato="@(Model.Contato ?? "")"
    data-cnpj="@(Model.CNPJ ?? "")"
    data-ie="@(Model.InscricaoEstadual ?? "")"
    data-razao="@(Model.RazaoSocial ?? "")"
    data-fantasia="@(Model.NomeFantasia ?? "")"
    data-logradouro="@(Model.Logradouro ?? "")"
    data-numero="@(Model.Numero ?? "")"
    data-complemento="@(Model.Complemento ?? "")"
    data-bairro="@(Model.Bairro ?? "")"
    data-cidade="@(Model.Cidade ?? "")"
    data-uf="@(Model.UF ?? "")"
    data-cep="@(Model.CEP ?? "")"
    data-banco="@(Model.Banco ?? "")"
    data-agencia="@(Model.Agencia ?? "")"
    data-conta="@(Model.Conta ?? "")"
    data-tipoconta="@(Model.TipoConta ?? "")"
    data-observacoes="@(Model.Observacoes ?? "")"
    class="@(!Model.Status ? "table-secondary text-muted" : "")">

    <td style="font-weight:600;">@Model.Nome</td>
    <td style="font-size:12px;">@(Model.Contato ?? "—")</td>
    <td style="font-size:12px;color:#64748b;">@(Model.CNPJ ?? "—")</td>
    <td style="font-size:12px;">@(Model.Banco ?? "—")</td>
    <td>
        @if (Model.Status)
        {
            <span class="badge bg-success-soft">Ativo</span>
        }
        else
        {
            <span class="badge bg-danger-soft">Inativo</span>
        }
    </td>
    <td>
        <div class="d-flex gap-1">
            <button class="btn-act btn-act-blue" onclick="editarFornecedor(@Model.Id)">Editar</button>
            <button class="btn-act btn-act-warn" onclick="toggleStatus(@Model.Id)">@(Model.Status ? "Inativar" : "Ativar")</button>
            <button class="btn-act btn-act-red"  onclick="confirmarExcluir(@Model.Id)">Excluir</button>
        </div>
    </td>
</tr>
