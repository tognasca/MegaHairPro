@model IEnumerable<MegaHairPro.Web.Models.Produto>

@{
    ViewData["Title"] = "Produtos";
}

<div class="page-header">
    <div class="page-title">Produtos</div>
    <div class="page-sub">Cadastro e controle de produtos em estoque</div>
</div>

<div class="section-card">
    <div class="section-label">Novo produto</div>
    <form id="formProduto">
        @Html.AntiForgeryToken()
        <div class="row g-3 align-items-end">
            <div class="col-md-2">
                <label class="form-label">Tipo</label>
                <select name="TipoProduto" id="TipoProduto" class="form-select" required>
                    <option value="">Selecione</option>
                    <option value="1">Cabelo</option>
                    <option value="2">Acessório</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Unidade</label>
                <select name="UnidadeMedida" id="UnidadeMedida" class="form-select" required>
                    <option value="1">g</option>
                    <option value="2">mL</option>
                </select>
            </div>
            <div class="col-md-3 campo-cabelo-nome d-none">
                <label class="form-label">Nome</label>
                <input name="Nome" id="txtnome" class="form-control" />
            </div>
            <div class="col-md-2 campo-cabelo">
                <label class="form-label">Origem</label>
                <select name="Origem" class="form-select">
                    <option value="">Selecione</option>
                    <option>Indiano</option><option>Vietnamita</option>
                    <option>Russo</option><option>Brasileiro</option>
                </select>
            </div>
            <div class="col-md-2 campo-cabelo">
                <label class="form-label">Tamanho</label>
                <select name="Tamanho" class="form-select">
                    <option value="">Selecione</option>
                    <option>40cm</option><option>45cm</option><option>50cm</option>
                    <option>55cm</option><option>60cm</option><option>65cm</option><option>70cm</option>
                </select>
            </div>
            <div class="col-md-2 campo-cabelo">
                <label class="form-label">Cor</label>
                <select name="Cor" class="form-select">
                    <option value="">Selecione</option>
                    <option>Castanho</option><option>Castanho Claro</option>
                    <option>Castanho Escuro</option><option>Louro</option><option>Preto</option>
                </select>
            </div>
            <div class="col-md-5 campo-acessorio d-none">
                <label class="form-label">Descrição</label>
                <input name="Descricao" class="form-control" />
            </div>
            <div class="col-md-1">
                <button id="btnSalvar" class="btn btn-success w-100">Salvar</button>
            </div>
        </div>
    </form>
</div>

<!-- FILTROS -->
<div class="section-card">
    <div class="section-label">Filtros</div>
    <div class="row g-3">
        <div class="col-md-3">
            <input type="text" id="filtroNome" class="form-control" placeholder="Buscar por nome..." />
        </div>
        <div class="col-md-2">
            <select id="filtroOrigem" class="form-select">
                <option value="">Origem</option>
                <option>Indiano</option><option>Vietnamita</option>
                <option>Russo</option><option>Brasileiro</option>
            </select>
        </div>
        <div class="col-md-2">
            <select id="filtroStatus" class="form-select">
                <option value="">Status</option>
                <option value="true">Ativo</option>
                <option value="false">Inativo</option>
            </select>
        </div>
        <div class="col-md-1">
            <button class="btn btn-outline-secondary w-100" onclick="limparFiltro()">Limpar</button>
        </div>
    </div>
</div>

<!-- LISTAGEM -->
<div class="table-card">
    <div class="table-card-header">
        <span class="table-card-title">Produtos registrados</span>
        <span class="table-count">@Model.Count() registros</span>
    </div>
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Tipo</th>
                    <th>Origem</th>
                    <th>Tamanho</th>
                    <th>Cor</th>
                    <th class="text-center">Status</th>
                    <th class="text-center" width="200">Ações</th>
                </tr>
            </thead>
            <tbody id="produtosBody">
                @foreach (var p in Model) { @Html.Partial("_ProdutoRow", p) }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL EDITAR -->
<div class="modal fade" id="modalEditarProduto" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Editar Produto</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editId" />
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Tipo</label>
                        <select id="editTipo" class="form-select">
                            <option value="1">Cabelo</option>
                            <option value="2">Acessório</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Unidade</label>
                        <select id="editUnidadeMedida" class="form-select">
                            <option value="1">g</option>
                            <option value="2">mL</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Origem</label>
                        <select id="editOrigem" class="form-select">
                            <option>Indiano</option><option>Vietnamita</option>
                            <option>Russo</option><option>Brasileiro</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Tamanho</label>
                        <select id="editTamanho" class="form-select">
                            <option>40cm</option><option>45cm</option><option>50cm</option>
                            <option>55cm</option><option>60cm</option><option>65cm</option><option>70cm</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Cor</label>
                        <select id="editCor" class="form-select">
                            <option>Castanho</option><option>Castanho Claro</option>
                            <option>Castanho Escuro</option><option>Louro</option>
                            <option>Preto</option><option>Ruivo</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-success px-4" onclick="salvarEdicao()">Salvar</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL EXCLUIR -->
<div class="modal fade" id="modalExcluir" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white border-0"><h5>Confirmar exclusão</h5></div>
            <div class="modal-body text-center">
                <p>Deseja excluir este produto?</p>
                <input type="hidden" id="excluirId" />
            </div>
            <div class="modal-footer border-0">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-danger" id="btnExcluir">Excluir</button>
            </div>
        </div>
    </div>
</div>

<!-- TOAST -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="toast" class="toast align-items-center text-white border-0">
        <div class="d-flex align-items-center">
            <div id="toastMsg" class="toast-body"></div>
            <button class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<script>
    let modalEditarProduto, modalExcluir;

    document.addEventListener("DOMContentLoaded", function () {
        $(".campo-cabelo-nome").addClass("d-none");
        modalEditarProduto = new bootstrap.Modal(document.getElementById("modalEditarProduto"));
        modalExcluir       = new bootstrap.Modal(document.getElementById("modalExcluir"));
        aplicarRegraUnidade($("#TipoProduto").val());
    });

    function aplicarRegraUnidade(tipo) {
        if (tipo === "1") { $("#UnidadeMedida").val("1").prop("disabled", true); $("#editUnidadeMedida").val("1").prop("disabled", true); }
        else              { $("#UnidadeMedida").prop("disabled", false); $("#editUnidadeMedida").prop("disabled", false); }
    }

    $("#TipoProduto").change(function () {
        let tipo = $(this).val();
        if (tipo == "2") { $(".campo-cabelo").addClass("d-none"); $(".campo-acessorio").removeClass("d-none"); }
        else             { $(".campo-cabelo").removeClass("d-none"); $(".campo-acessorio").addClass("d-none"); }
        aplicarRegraUnidade(tipo);
    });

    function getToken() { return $('input[name="__RequestVerificationToken"]').first().val(); }

    function toast(msg, tipo) {
        let t = $("#toast");
        t.removeClass("bg-success bg-danger bg-warning");
        t.addClass(tipo);
        $("#toastMsg").text(msg);
        new bootstrap.Toast(t[0], { delay: 3000 }).show();
    }

    $("#formProduto").submit(function (e) {
        e.preventDefault();
        let btn = $("#btnSalvar").html("Salvando...").prop("disabled", true);
        $.ajax({
            url: "/Produtos/CreateAjax", type: "POST", data: new FormData(this),
            processData: false, contentType: false,
            success: function (html) { $("#produtosBody").prepend(html); toast("Produto salvo", "bg-success"); limpar(); },
            error: function () { toast("Erro ao salvar", "bg-danger"); },
            complete: function () { btn.html("Salvar").prop("disabled", false); }
        });
    });

    function limpar() { $("#formProduto")[0].reset(); aplicarRegraUnidade($("#TipoProduto").val()); }

    function editarProduto(id) {
        let row = document.getElementById("row-" + id);
        $("#editId").val(id);
        $("#editTipo").val(row.dataset.tipo);
        $("#editOrigem").val(row.dataset.origem);
        $("#editTamanho").val(row.dataset.tamanho);
        $("#editCor").val(row.dataset.cor);
        $("#editUnidadeMedida").val(row.dataset.unidade || "1");
        aplicarRegraUnidade($("#editTipo").val());
        modalEditarProduto.show();
    }

    function salvarEdicao() {
        let id = $("#editId").val();
        let fd = new FormData();
        fd.append("Id", id); fd.append("TipoProduto", $("#editTipo").val());
        fd.append("UnidadeMedida", $("#editUnidadeMedida").val());
        fd.append("Origem", $("#editOrigem").val()); fd.append("Tamanho", $("#editTamanho").val());
        fd.append("Cor", $("#editCor").val());
        fd.append("__RequestVerificationToken", getToken());
        $.ajax({
            url: '/Produtos/EditAjax', type: 'POST', data: fd, processData: false, contentType: false,
            success: function (html) { $("#row-" + id).replaceWith(html); modalEditarProduto.hide(); toast("Editado com sucesso", "bg-success"); },
            error: function () { toast("Erro ao editar", "bg-danger"); }
        });
    }

    function toggleStatus(id) {
        let fd = new FormData();
        fd.append("Id", id); fd.append("__RequestVerificationToken", getToken());
        $.ajax({
            url: '/Produtos/ToggleStatusAjax', type: 'POST', data: fd, processData: false, contentType: false,
            success: function (html) { $("#row-" + id).replaceWith(html); toast("Status alterado", "bg-warning"); }
        });
    }

    function confirmarExcluir(id) { $("#excluirId").val(id); modalExcluir.show(); }

    $("#btnExcluir").click(function () {
        let id = $("#excluirId").val();
        let btn = $(this).html("Excluindo...").prop("disabled", true);
        let fd = new FormData(); fd.append("id", id); fd.append("__RequestVerificationToken", getToken());
        $.ajax({
            url: "/Produtos/DeleteAjax", type: "POST", data: fd, processData: false, contentType: false,
            success: function () { $("#row-" + id).fadeOut(300, function () { $(this).remove(); }); modalExcluir.hide(); toast("Produto excluído", "bg-success"); },
            error: function () { toast("Erro ao excluir", "bg-danger"); },
            complete: function () { btn.html("Excluir").prop("disabled", false); }
        });
    });

    $("#filtroNome, #filtroOrigem, #filtroStatus").on("keyup change", filtrar);

    function filtrar() {
        let nome   = $("#filtroNome").val().toLowerCase();
        let origem = $("#filtroOrigem").val();
        let status = $("#filtroStatus").val();
        $("#produtosBody tr").each(function () {
            let r = $(this);
            let ok = r.data("nome").toLowerCase().includes(nome) &&
                     (origem == "" || r.data("origem") == origem) &&
                     (status == "" || r.data("status").toString() == status);
            r.toggle(ok);
        });
    }

    function limparFiltro() { $("#filtroNome, #filtroOrigem, #filtroStatus").val(""); filtrar(); }
</script>
