@{
    ViewData["Title"] = "Produtos do Simulador";
}

<div class="page-header">
    <div class="page-title">Produtos do Simulador</div>
    <div class="page-sub">Cadastro de origens e orçamento</div>
</div>

@if (User.IsInRole("Admin"))
{
    var mostrarOrcamento = ViewBag.MostrarOrcamentoAntes is true;
    var origens = ViewBag.OrigensSimulador as MegaHairPro.Web.Controllers.ProdutosController.OrigemSimulador[];
    <section class="section-card" aria-labelledby="titulo-simulador">
        <h2 id="titulo-simulador" class="section-label">Produtos do Simulador</h2>
        @if (TempData["SimuladorSucesso"] is string sucesso)
        {
            <p role="status" class="alert alert-success">@sucesso</p>
        }
        @if (TempData["SimuladorErro"] is string alerta)
        {
            <p role="alert" class="alert alert-warning">@alerta</p>
        }
        <p>Cadastre as origens padrão e registre uma compra com gramagem e custo para cada origem que quiser disponibilizar.</p>
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <form method="post" action="@Url.RouteUrl("CadastrarProdutosDoSimulador")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="voltar" value="true" />
                <button type="submit" class="btn btn-primary">Cadastrar origens padrão</button>
            </form>
            <a href="@Url.Action("Index", "Compras")" class="btn btn-outline-secondary">Ir para Compras</a>
        </div>
        @if (origens is not null)
        {
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead><tr><th scope="col">Origem</th><th scope="col">Código</th><th scope="col">Situação</th></tr></thead>
                    <tbody>
                        @foreach (var origem in origens)
                        {
                            <tr><td>@origem.Nome</td><td>@origem.Codigo</td><td>@origem.Situacao</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <form method="post" action="@Url.Action("SalvarOrcamentoAntes", "Produtos")" class="border-top pt-3">
            @Html.AntiForgeryToken()
            <div class="form-check form-switch">
                <input type="checkbox" class="form-check-input" id="mostrarOrcamentoAntes"
                       name="ativo" value="true" checked="@mostrarOrcamento" />
                <label class="form-check-label" for="mostrarOrcamentoAntes">Mostrar orçamento antes de gerar a imagem</label>
            </div>
            <button type="submit" class="btn btn-outline-secondary mt-2">Salvar configuração do orçamento</button>
        </form>
    </section>
}

