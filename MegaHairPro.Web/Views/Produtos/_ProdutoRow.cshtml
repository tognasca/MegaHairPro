@model MegaHairPro.Web.Models.Produto

<tr id="row-@Model.Id"
    data-tipo="@((int)Model.TipoProduto)"
    data-unidade="@((int)Model.UnidadeMedida)"
    data-nome="@(Model.Descricao ?? "")"
    data-origem="@(Model.Origem ?? "")"
    data-tamanho="@(Model.Tamanho ?? "")"
    data-cor="@(Model.Cor ?? "")"
    data-status="@Model.Status.ToString().ToLower()"
    class="@(!Model.Status ? "table-secondary text-muted" : "")">

    <td style="font-weight:600;font-size:13px;">@Model.Codigo</td>
    <td style="font-size:12px;color:#64748b;">@Model.TipoProduto</td>
    <td style="font-size:12px;color:#64748b;">@Model.Descricao</td>    
    <td style="font-size:13px;">@(Model.Origem ?? "—")</td>
    <td style="font-size:13px;">@(Model.Tamanho ?? "—")</td>
    <td style="font-size:13px;">@(Model.Cor ?? "—")</td>
    <td class="text-center">
        @if (Model.Status)
        {
            <span class="badge bg-success-soft">Ativo</span>
        }
        else
        {
            <span class="badge bg-danger-soft">Inativo</span>
        }
    </td>
    <td class="text-center">
        <div class="d-flex gap-1 justify-content-center">
            <button class="btn-act btn-act-blue" onclick="editarProduto(@Model.Id)">Editar</button>
            <button class="btn-act btn-act-warn" onclick="toggleStatus(@Model.Id)">@(Model.Status ? "Inativar" : "Ativar")</button>
            <button class="btn-act btn-act-red"  onclick="confirmarExcluir(@Model.Id)">Excluir</button>
        </div>
    </td>
</tr>
