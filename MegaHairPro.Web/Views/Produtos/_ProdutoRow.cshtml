    @model MegaHairPro.Web.Models.Produto

    <tr id="row-@Model.Id"
        data-nome="@Model.Nome"
        data-tipo="@((int)Model.TipoProduto)"
        data-origem="@Model.Origem"
        data-tamanho="@Model.Tamanho"
        data-cor="@Model.Cor"
        class="@(Model.Status ? "" : "table-secondary text-muted")">

        <td>@Model.Codigo</td>
        <td>@Model.TipoProduto</td>
        <td>@Model.Nome</td>
        <td>@Model.Origem</td>
        <td>@Model.Tamanho</td>
        <td>@Model.Cor</td>


        <td class="text-center">

            <button class="btn btn-sm btn-outline-primary"
                    onclick="editarProduto(@Model.Id)">
                Editar
            </button>

            <button class="btn btn-sm btn-outline-warning"
                    onclick="toggleStatus(@Model.Id)">
                @(Model.Status ? "Inativar" : "Ativar")
            </button>

            <button class="btn btn-sm btn-outline-danger"
                    onclick="excluirProduto(@Model.Id)">
                Excluir
            </button>



        </td>
    </tr>
