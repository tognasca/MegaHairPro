@model MegaHairPro.Web.Models.Profissional
<tr id="row-@Model.Id" data-nome="@Model.Nome" data-especialidade="@(Model.Especialidade ?? "")">
    <td style="font-weight:600;">@Model.Nome</td>
    <td style="color:#64748b;font-size:13px;">@(Model.Especialidade ?? "—")</td>
    <td class="text-center">
        <div class="d-flex gap-1 justify-content-center">
            <button class="btn-act btn-act-blue" onclick="editarProfissional(@Model.Id)">Editar</button>
            <button class="btn-act btn-act-red"  onclick="confirmarExcluir(@Model.Id)">Excluir</button>
        </div>
    </td>
</tr>
