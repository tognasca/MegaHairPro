@model IEnumerable<MegaHairPro.Web.Models.Comissao>
@{
    ViewData["Title"] = "Relatório de Comissões";
}

h2 class="mb-3">Relatório de Comissões</h2>

<div class="card-premium mb-3">
    <form method="get" class="row g-3">
        <div class="col-md-3">
            <label>Início</label>
            <input type="date" name="inicio" class="form-control" value="@ViewBag.Inicio" />
        </div>
        <div class="col-md-3">
            <label>Fim</label>
            <input type="date" name="fim" class="form-control" value="@ViewBag.Fim" />
        </div>
        <div class="col-md-3 mt-3">
            <button class="btn btn-primary w-100">Filtrar</button>
        </div>
    </form>
</div>

<div class="card shadow-sm p-3 rounded-4 mb-3">
    <h6 class="text-muted">Total Comissões</h6>
    <h3 class="fw-bold text-danger">
        R$ @((decimal)ViewBag.TotalComissoes).ToString("N2")
    </h3>
</div>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Data</th>
            <th>Profissional</th>
            <th>Valor</th>
            <th>Pago</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.DataGeracao.ToString("dd/MM/yyyy")</td>
                <td>@c.Profissional</td>
                <td>R$ @c.Valor.ToString("N2")</td>
                <td>@(c.Pago ? "Sim" : "Não")</td>
            </tr>
        }
    </tbody>
</table>

