@model MegaHairPro.Web.Models.Servico

@{
    ViewData["Title"] = "Serviços";
}

<h2>Editar Serviço</h2>

<form action="/Servico/Edit" method="post">

    <input type="hidden" asp-for="Id" />

    <input asp-for="Nome" class="form-control" />

    <input asp-for="Valor" class="form-control mt-2" />

    <input asp-for="DuracaoMinutos" class="form-control mt-2" />

    <button class="btn btn-primary mt-3">Atualizar</button>
    <a href="/Servico" class="btn btn-secondary mt-3">Voltar</a>

</form>
