@model IEnumerable<MegaHairPro.Web.Models.Servico>

@{
    ViewData["Title"] = "Serviços";
}

<div class="page-header">
    <div class="page-title">Serviços</div>
    <div class="page-sub">Cadastro de serviços e valores para agendamento</div>
</div>

<div class="section-card">
    <div class="section-label">Novo serviço</div>
    <form id="formServico">
        @Html.AntiForgeryToken()
        <div class="row g-3 align-items-end">
            <div class="col-md-3"><label class="form-label">Nome</label><input id="novoNome" name="Nome" class="form-control" placeholder="Nome do serviço" required /></div>
            <div class="col-md-2">
                <label class="form-label">Categoria</label>
                <select id="novaCategoria" name="Categoria" class="form-select">
                    <option value="1">Cabelo</option><option value="2">Unha</option>
                    <option value="3">Tratamento</option><option value="4">Mega Hair</option>
                </select>
            </div>
            <div class="col-md-2"><label class="form-label">Valor (R$)</label><input id="novoValor" name="Valor" class="form-control" placeholder="0,00" /></div>
            <div class="col-md-2"><label class="form-label">Valor Promocional</label><input id="novoValorProm" name="ValorPromocional" class="form-control" placeholder="0,00" /></div>
            <div class="col-md-1"><label class="form-label">Duração (min)</label><input id="novaDuracao" name="DuracaoMinutos" type="number" class="form-control" placeholder="60" min="1" /></div>
            <div class="col-md-1"><label class="form-label">Descrição</label><input id="novaDescricao" name="Descricao" class="form-control" placeholder="Opcional" /></div>
            <div class="col-md-1 d-flex align-items-end"><button id="btnSalvar" class="btn btn-success w-100">Salvar</button></div>
        </div>
    </form>
</div>

<div class="table-card">
    <div class="table-card-header">
        <span class="table-card-title">Serviços registrados</span>
        <span class="table-count">@Model.Count() registros</span>
    </div>
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Nome</th><th>Categoria</th>
                    <th class="text-end">Valor</th>
                    <th class="text-center">Duração</th>
                    <th class="text-center" width="150">Ações</th>
                </tr>
            </thead>
            <tbody id="servicosBody">
                @foreach (var s in Model) { @Html.Partial("_ServicoRow", s) }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL EDITAR -->
<div class="modal fade" id="modalEditar" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0"><h5 class="modal-title fw-bold">Editar Serviço</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <input type="hidden" id="editId" />
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label">Nome</label><input id="editNome" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label">Categoria</label><select id="editCategoria" class="form-select"><option value="1">Cabelo</option><option value="2">Unha</option><option value="3">Tratamento</option><option value="4">Mega Hair</option></select></div>
                    <div class="col-md-4"><label class="form-label">Valor</label><input id="editValor" class="form-control" placeholder="0,00" /></div>
                    <div class="col-md-4"><label class="form-label">Valor Promocional</label><input id="editValorProm" class="form-control" placeholder="0,00" /></div>
                    <div class="col-md-4"><label class="form-label">Duração (min)</label><input id="editDuracao" type="number" class="form-control" min="1" /></div>
                    <div class="col-12"><label class="form-label">Descrição</label><input id="editDescricao" class="form-control" placeholder="Opcional" /></div>
                </div>
            </div>
            <div class="modal-footer border-0"><button class="btn btn-light" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-success px-4" onclick="salvarEdicao()">Salvar</button></div>
        </div>
    </div>
</div>

<!-- MODAL EXCLUIR -->
<div class="modal fade" id="modalExcluir" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white border-0"><h5>Confirmar exclusão</h5></div>
            <div class="modal-body text-center"><p>Deseja excluir este serviço?</p><input type="hidden" id="excluirId" /></div>
            <div class="modal-footer border-0"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-danger" id="btnExcluir">Excluir</button></div>
        </div>
    </div>
</div>

<!-- TOAST -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="toast" class="toast align-items-center text-white border-0">
        <div class="d-flex align-items-center"><div id="toastMsg" class="toast-body"></div><button class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div>
    </div>
</div>

<script>
    let modalEditar, modalExcluir;
    document.addEventListener("DOMContentLoaded", function () {
        modalEditar  = new bootstrap.Modal(document.getElementById("modalEditar"));
        modalExcluir = new bootstrap.Modal(document.getElementById("modalExcluir"));
        aplicarMascara(document.getElementById("novoValor"));
        aplicarMascara(document.getElementById("novoValorProm"));
    });
    function aplicarMascara(input) {
        if (!input || input._mascaraAplicada) return;
        input._mascaraAplicada = true;
        input.addEventListener("input", function () { let v=this.value.replace(/\D/g,""); v=(parseInt(v||"0",10)/100).toFixed(2); this.value=v.replace(".",","); });
    }
    function parseBR(val) { return parseFloat((val||"0").replace(/\./g,"").replace(",",".")) || 0; }
    function getToken()   { return $('input[name="__RequestVerificationToken"]').first().val(); }
    function toast(msg,tipo) { let t=$("#toast"); t.removeClass("bg-success bg-danger bg-warning"); t.addClass(tipo); $("#toastMsg").text(msg); new bootstrap.Toast(t[0],{delay:3000}).show(); }
    $("#formServico").submit(function(e) {
        e.preventDefault(); let btn=$("#btnSalvar").html("Salvando...").prop("disabled",true);
        let fd=new FormData(this); fd.set("Valor",parseBR($("#novoValor").val()).toString()); fd.set("ValorPromocional",parseBR($("#novoValorProm").val()).toString());
        $.ajax({url:"/Servico/CreateAjax",type:"POST",data:fd,processData:false,contentType:false,
            success:function(html){$("#servicosBody").prepend(html);toast("Serviço salvo","bg-success");$("#formServico")[0].reset();},
            error:function(){toast("Erro ao salvar","bg-danger");},complete:function(){btn.html("Salvar").prop("disabled",false);}});
    });
    function editarServico(id) {
        let row=document.getElementById("row-"+id); $("#editId").val(id); $("#editNome").val(row.dataset.nome);
        $("#editDescricao").val(row.dataset.descricao); $("#editCategoria").val(row.dataset.categoria); $("#editDuracao").val(row.dataset.duracao);
        let iv=document.getElementById("editValor"); iv.value=parseFloat(row.dataset.valor||0).toFixed(2).replace(".",","); aplicarMascara(iv);
        let ip=document.getElementById("editValorProm"); ip.value=row.dataset.valorpromocional?parseFloat(row.dataset.valorpromocional).toFixed(2).replace(".",","):""; aplicarMascara(ip);
        modalEditar.show();
    }
    function salvarEdicao() {
        let id=$("#editId").val(); let fd=new FormData();
        fd.append("Id",id); fd.append("Nome",$("#editNome").val()); fd.append("Descricao",$("#editDescricao").val());
        fd.append("Categoria",$("#editCategoria").val()); fd.append("Valor",parseBR($("#editValor").val()).toString());
        fd.append("ValorPromocional",parseBR($("#editValorProm").val()).toString()); fd.append("DuracaoMinutos",$("#editDuracao").val());
        fd.append("__RequestVerificationToken",getToken());
        $.ajax({url:"/Servico/EditAjax",type:"POST",data:fd,processData:false,contentType:false,
            success:function(html){$("#row-"+id).replaceWith(html);modalEditar.hide();toast("Editado","bg-success");},
            error:function(){toast("Erro ao editar","bg-danger");}});
    }
    function confirmarExcluir(id) { $("#excluirId").val(id); modalExcluir.show(); }
    $("#btnExcluir").click(function() {
        let id=$("#excluirId").val(); let btn=$(this).html("Excluindo...").prop("disabled",true);
        let fd=new FormData(); fd.append("id",id); fd.append("__RequestVerificationToken",getToken());
        $.ajax({url:"/Servico/Delete",type:"POST",data:fd,processData:false,contentType:false,
            success:function(){$("#row-"+id).fadeOut(300,function(){$(this).remove();}); modalExcluir.hide(); toast("Serviço excluído","bg-success");},
            error:function(xhr){modalExcluir.hide(); toast(xhr.responseText||"Erro ao excluir","bg-danger");},
            complete:function(){btn.html("Excluir").prop("disabled",false);}});
    });
</script>
