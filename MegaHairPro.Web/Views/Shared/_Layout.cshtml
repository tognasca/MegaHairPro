<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>MegaHairPro</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
     <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>



    <!-- ✅ jQuery obrigatório -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- ✅ Plugin Mask -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js"></script>


    <style>
        body {
            background-color: #f4f6f9;
        }

        .sidebar {
            width: 260px;
            min-height: 100vh;
            background-color: #1f2937;
        }

            .sidebar a {
                color: #d1d5db;
                text-decoration: none;
            }

                .sidebar a:hover {
                    background-color: #374151;
                    color: #fff;
                }

            .sidebar .active {
                background-color: #111827;
                color: #fff;
            }

        .content {
            padding: 25px;
        }

        hr {
            border-color: #374151;
        }
    </style>
</head>

<body>
    <div class="d-flex">

        <!-- SIDEBAR -->
        <aside class="sidebar p-3">
            <h4 class="text-white mb-4">MegaHairPro</h4>

            <nav class="nav flex-column gap-1">

                <!-- CADASTROS -->
                <span class="text-uppercase text-secondary small px-2">Cadastros</span>

                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Produtos" ? "active" : "")"
                   href="/Produtos/Index">
                    <i class="bi bi-box-seam"></i> Produtos
                </a>

                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Fornecedores" ? "active" : "")"
                   href="/Fornecedores/Index">
                    <i class="bi bi-truck"></i> Fornecedores
                </a>

                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Clientes" ? "active" : "")"
                   href="/Clientes/Index">
                    <i class="bi bi-truck"></i> Clientes
                </a>

                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "MetodosAplicacao" ? "active" : "")"
                   href="/MetodosAplicacao/Index">
                    <i class="bi bi-scissors"></i> Métodos de Aplicação
                </a>

                <!-- MOVIMENTAÇÃO -->
                <span class="text-uppercase text-secondary small px-2">Movimentação</span>

                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Compras" ? "active" : "")"
                   href="/Compras/Index">
                    <i class="bi bi-cart-plus"></i> Compras
                </a>

                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Despesas" ? "active" : "")"
                   href="/Despesas/Index">
                    <i class="bi bi-cash-coin"></i> Despesas
                </a>

                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Simulacao" ? "active" : "")"
                   href="/Simulacao/Index">
                    <i class="bi bi-cash-coin"></i> Simulação
                </a>

                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Vendas" ? "active" : "")"
                   href="/Venda/Index">
                    <i class="bi bi-cash-coin"></i> Vendas
                </a>

                <hr />       

            </nav>
        </aside>

        <!-- CONTEÚDO -->
        <div class="flex-grow-1">

            <!-- TOPBAR -->
            <nav class="navbar navbar-light bg-white border-bottom px-4">
                <span class="navbar-text fw-semibold">
                    Sistema de Gestão de Mega Hair
                </span>
            </nav>

            <!-- BODY -->
            <main class="content">
                @RenderBody()
            </main>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
