<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>@(ViewData["Title"] ?? "MegaHairPro")</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.maskMoney/3.0.2/jquery.maskMoney.min.js"></script>

    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>


    <style>
        :root {
            --sidebar-w: 230px;
            --topbar-h:  52px;
            --navy:      #1a2e4a;
            --navy-dark: #0f1e30;
            --navy-mid:  #243858;
            --gold:      #c9a84c;
            --gold-light:#e2c47a;
            --active-bg: rgba(201,168,76,0.12);
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body { background: #f1f5f9; font-family: 'Segoe UI', sans-serif; color: #0f172a; }

        /* ── OVERLAY ── */
        .sidebar-overlay {
            display: none; position: fixed; inset: 0;
            background: rgba(0,0,0,.5); z-index: 1099;
        }
        .sidebar-overlay.active { display: block; }

        /* ── TOPBAR ── */
        .topbar {
            position: fixed; top: 0; left: var(--sidebar-w); right: 0;
            height: var(--topbar-h); background: #fff;
            border-bottom: 1px solid #e2e8f0;
            display: flex; align-items: center; justify-content: space-between;
            padding: 0 16px; z-index: 999; gap: 8px;
        }
        .topbar-left { display: flex; align-items: center; gap: 8px; min-width: 0; flex: 1; }
        .topbar-title { font-size: 14px; font-weight: 600; color: #0f172a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .topbar-right { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
        .topbar-label { display: inline; }

        /* Hamburguer — escondido no desktop */
        .btn-menu {
            display: none; background: none; border: none;
            padding: 6px; cursor: pointer; color: var(--navy); flex-shrink: 0;
        }

        /* ── SIDEBAR ── */
        .sidebar {
            width: var(--sidebar-w); height: 100vh;
            background: var(--navy-dark); position: fixed; top: 0; left: 0;
            display: flex; flex-direction: column;
            z-index: 1100; overflow: hidden;
            border-right: 1px solid rgba(201,168,76,0.1);
            transition: transform .28s ease;
        }
        .sidebar::before {
            content: ''; display: block; height: 2px; flex-shrink: 0;
            background: linear-gradient(90deg, transparent, var(--gold), transparent);
        }

        .sb-brand {
            padding: 14px 16px; flex-shrink: 0;
            border-bottom: 1px solid rgba(255,255,255,.06);
            display: flex; align-items: center; gap: 10px;
        }
        .sb-close {
            display: none; margin-left: auto; background: none; border: none;
            color: #64748b; cursor: pointer; padding: 4px; font-size: 18px;
        }
        .sb-icon {
            width: 34px; height: 34px; border-radius: 8px; background: var(--gold);
            display: flex; align-items: center; justify-content: center;
            color: var(--navy-dark); font-weight: 700; font-size: 13px; flex-shrink: 0;
        }
        .sb-name { color: #f1f5f9; font-size: 13px; font-weight: 600; }
        .sb-sub  { color: #64748b; font-size: 10px; }

        .sb-nav {
            flex: 1; overflow-y: auto; overflow-x: hidden; padding: 6px 0 12px;
            scrollbar-width: thin; scrollbar-color: #1e293b transparent;
        }
        .sb-nav::-webkit-scrollbar { width: 3px; }
        .sb-nav::-webkit-scrollbar-thumb { background: #243858; border-radius: 3px; }

        .sb-section {
            font-size: 10px; text-transform: uppercase; letter-spacing: 1px;
            color: #475569; padding: 10px 16px 3px; font-weight: 700;
        }
        .sb-link {
            display: flex; align-items: center; gap: 9px;
            padding: 9px 14px; margin: 1px 8px; border-radius: 7px;
            color: #94a3b8; text-decoration: none; font-size: 13px; font-weight: 500;
            transition: background .15s, color .15s, padding-left .15s;
        }
        .sb-link i { font-size: 14px; width: 16px; text-align: center; flex-shrink: 0; }
        .sb-link:hover { background: rgba(201,168,76,0.08); color: var(--gold-light); padding-left: 18px; }
        .sb-link.active {
            background: var(--active-bg); color: var(--gold);
            border-left: 2px solid var(--gold); padding-left: 12px; font-weight: 600;
        }

        .sb-footer {
            border-top: 1px solid rgba(255,255,255,.06);
            padding: 10px 14px; flex-shrink: 0;
            display: flex; align-items: center; gap: 9px;
        }
        .sb-avatar {
            width: 30px; height: 30px; border-radius: 50%; background: var(--gold);
            display: flex; align-items: center; justify-content: center;
            color: var(--navy-dark); font-size: 11px; font-weight: 700; flex-shrink: 0;
        }
        .sb-uname { color: #cbd5e1; font-size: 11.5px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .sb-urole { color: #475569; font-size: 10px; }

        /* ── CONTENT ── */
        .content {
            margin-left: var(--sidebar-w); margin-top: var(--topbar-h);
            padding: 24px; min-height: calc(100vh - var(--topbar-h));
            animation: fadeUp .3s ease;
        }
        @@keyframes fadeUp { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:none; } }

        /* ── PAGE HEADER ── */
        .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; gap: 12px; flex-wrap: wrap; }
        .page-title { font-size: 20px; font-weight: 600; color: #0f172a; }
        .page-sub   { font-size: 13px; color: #64748b; margin-top: 2px; }

        /* ── CARDS ── */
        .section-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px; margin-bottom: 14px; }
        .section-label {
            font-size: 10px; text-transform: uppercase; letter-spacing: 1px;
            color: #94a3b8; font-weight: 700; margin-bottom: 14px;
            display: flex; align-items: center; gap: 8px;
        }
        .section-label::after { content: ''; flex: 1; height: 1px; background: #f1f5f9; }
        .card-premium { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px; margin-bottom: 14px; }

        /* ── FORM ── */
        .form-label { font-size: 11px; color: #64748b; font-weight: 600; margin-bottom: 4px; }
        .form-control, .form-select {
            font-size: 13px; padding: 7px 10px; border-radius: 7px;
            border: 1px solid #cbd5e1; background: #fff; color: #0f172a; width: 100%;
        }
        .form-control:focus, .form-select:focus { outline: none; border-color: var(--gold); box-shadow: 0 0 0 3px rgba(201,168,76,0.12); }
        .form-control[readonly] { background: #f8fafc; color: #64748b; }

        /* ── BOTÕES HEADER ── */
        .btn-header-action {
            display: inline-flex; align-items: center; gap: 6px;
            background: var(--navy); color: #fff; border: 1px solid rgba(201,168,76,0.3);
            border-radius: 8px; padding: 9px 18px; font-size: .82rem; font-weight: 600;
            text-decoration: none; transition: opacity .2s; white-space: nowrap;
        }
        .btn-header-action:hover { opacity: .85; color: #fff; border-color: var(--gold); }
        .btn-header-back {
            display: inline-flex; align-items: center; gap: 6px;
            background: transparent; color: var(--navy); border: 1.5px solid #e5e7eb;
            border-radius: 8px; padding: 8px 16px; font-size: .82rem; font-weight: 500;
            text-decoration: none; white-space: nowrap;
        }
        .btn-header-back:hover { border-color: var(--navy); background: #f8fafc; color: var(--navy); }

        /* ── TOTAL BANNER ── */
        .total-banner {
            background: linear-gradient(135deg, var(--navy-dark), var(--navy-mid));
            border: 1px solid rgba(201,168,76,0.2); border-radius: 10px;
            padding: 16px 22px; display: flex; align-items: center;
            justify-content: space-between; margin: 16px 0; gap: 12px; flex-wrap: wrap;
        }
        .total-banner-label { color: var(--gold-light); font-size: 12px; font-weight: 500; }
        .total-banner-sub   { color: #475569; font-size: 10px; margin-top: 2px; }
        .total-banner-value { color: #fff; font-size: 28px; font-weight: 700; }

        /* ── TABLE ── */
        .table-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; margin-bottom: 14px; }
        .table-card-header { padding: 14px 20px; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; }
        .table-card-title { font-size: 14px; font-weight: 600; color: #0f172a; }
        .table-count { font-size: 11px; background: #f1f5f9; color: #64748b; padding: 3px 9px; border-radius: 20px; }
        .table { margin-bottom: 0; }
        .table thead th { background: #f8fafc; color: #64748b; font-size: 10px; text-transform: uppercase; letter-spacing: .8px; font-weight: 700; padding: 10px 16px; border-bottom: 1px solid #e2e8f0; border-top: none; white-space: nowrap; }
        .table tbody td { padding: 11px 16px; font-size: 13px; border-bottom: 1px solid #f1f5f9; vertical-align: middle; }
        .table tbody tr:last-child td { border-bottom: none; }
        .table tbody tr:hover td { background: #f8fafc; }

        /* ── BADGES ── */
        .badge { padding: 4px 9px; border-radius: 6px; font-size: 11px; font-weight: 600; }
        .bg-success-soft { background: #dcfce7 !important; color: #15803d !important; }
        .bg-warning-soft { background: #fef9c3 !important; color: #854d0e !important; }
        .bg-danger-soft  { background: #fee2e2 !important; color: #991b1b !important; }
        .bg-blue-soft    { background: #eff6ff !important; color: #1d4ed8 !important; }
        .bg-gold-soft    { background: rgba(201,168,76,0.12) !important; color: #92650a !important; }

        /* ── ACTION BUTTONS ── */
        .btn-act { padding: 4px 9px; border-radius: 5px; font-size: 11px; font-weight: 500; border: 1px solid; cursor: pointer; text-decoration: none; display: inline-block; transition: opacity .15s; }
        .btn-act:hover  { opacity: .8; }
        .btn-act-red   { background: #fee2e2; color: #991b1b; border-color: #fca5a5; }
        .btn-act-blue  { background: #eff6ff; color: #1d4ed8; border-color: #93c5fd; }
        .btn-act-dark  { background: #f1f5f9; color: #334155; border-color: #cbd5e1; }
        .btn-act-green { background: #dcfce7; color: #15803d; border-color: #86efac; }
        .btn-act-warn  { background: #fef9c3; color: #854d0e; border-color: #fde047; }
        .btn-act-navy  { background: rgba(26,46,74,0.08); color: var(--navy); border-color: rgba(26,46,74,0.2); }

        /* ── MISC ── */
        .metric-value { font-size: 1.75rem; font-weight: 700; margin-top: 6px; letter-spacing: -0.5px; }
        .btn   { border-radius: 7px; font-size: 13px; }
        .toast { border-radius: 10px; }
        .alert { border-radius: 8px; font-size: 13px; }
        .categoria-badge { display: flex; align-items: center; gap: 8px; }
        .dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; }

        /* ── TABELA — scroll horizontal em todas as telas ── */
        .table-card {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }
        .table-card .table { min-width: 600px; }
        .table-responsive {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        /* ══════════════════════════════════════════
           TABLET (max-width: 991px)
        ══════════════════════════════════════════ */
        @@media (max-width: 991px) {
            .topbar        { left: 0 !important; }
            .btn-menu      { display: flex !important; }
            .sidebar       { transform: translateX(-100%) !important; width: 270px !important; box-shadow: 4px 0 20px rgba(0,0,0,.3); }
            .sidebar.open  { transform: translateX(0) !important; }
            .sb-close      { display: block !important; }
            .content       { margin-left: 0 !important; padding: 16px !important; }
            .total-banner  { flex-direction: column; align-items: flex-start; }
            .total-banner-value { font-size: 22px; }
            .modal-dialog  { max-width: 94vw; }
        }

        /* ══════════════════════════════════════════
           MOBILE (max-width: 575px)
        ══════════════════════════════════════════ */
        @@media (max-width: 575px) {
            .content       { padding: 10px !important; }
            .topbar-label  { display: none !important; }
            .page-title    { font-size: 17px; }
            .section-card, .card-premium { padding: 14px; }
            .total-banner-value { font-size: 19px; }
            .modal-dialog  { margin: 6px; max-width: calc(100vw - 12px); }
            .btn-act       { padding: 5px 7px; font-size: 10px; }
            .table-card .table { min-width: 500px; }
        }
    </style>
</head>
<body>

@{
    bool isAdmin = User.IsInRole("Admin");
    string ctrl  = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string email = User.Identity?.Name ?? "";
    string ini   = email.Length > 0 ? email[0].ToString().ToUpper() : "U";
    string A(string c) => ctrl == c ? "active" : "";
}

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- TOPBAR -->
<header class="topbar">
    <div class="topbar-left">
        <button class="btn-menu" id="btnMenu" aria-label="Abrir menu">
            <i class="bi bi-list" style="font-size:22px;"></i>
        </button>
        <div class="topbar-title">@(ViewData["Title"] ?? "MegaHairPro")</div>
    </div>
    <div class="topbar-right">
        <span class="badge @(isAdmin ? "bg-danger" : "bg-primary") d-none d-sm-inline">
            @(isAdmin ? "Admin" : "Usuário")
        </span>
        <a href="/Account/MinhaConta" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-person-circle"></i><span class="topbar-label"> Minha Conta</span>
        </a>
        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button class="btn btn-sm btn-danger">
                <i class="bi bi-box-arrow-right"></i><span class="topbar-label"> Sair</span>
            </button>
        </form>
    </div>
</header>

<!-- SIDEBAR -->
<aside class="sidebar" id="sidebar">
    <div class="sb-brand">
        <div class="sb-icon">MH</div>
        <div><div class="sb-name">MegaHairPro</div><div class="sb-sub">Premium</div></div>
        <button class="sb-close" id="btnCloseSidebar" aria-label="Fechar menu">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <nav class="sb-nav">
        <div class="sb-section">Geral</div>
        <a href="/Dashboard/Index"      class="sb-link @A("Dashboard")">    <i class="bi bi-house-door"></i>    Dashboard </a>
        <a href="/Agendamento/Index"    class="sb-link @A("Agendamento")">  <i class="bi bi-calendar-week"></i> Agenda    </a>
        <a href="/Clientes/Index"       class="sb-link @A("Clientes")">     <i class="bi bi-people"></i>        Clientes  </a>
        <a href="/Fornecedores/Index"   class="sb-link @A("Fornecedores")"> <i class="bi bi-people"></i>        Fornecedores  </a>
        <a href="/Simulacao/Index"      class="sb-link @A("Simulacao")">    <i class="bi bi-calculator"></i>    Simulação </a>
        <a href="/Venda/Index"          class="sb-link @A("Venda")">        <i class="bi bi-bag-check"></i>     Vendas    </a>

        @if (isAdmin)
        {
            <div class="sb-section">Estoque</div>
            <a href="/Produtos/Index"         class="sb-link @A("Produtos")">         <i class="bi bi-box-seam"></i>       Produtos      </a>
            <a href="/Compras/Index"          class="sb-link @A("Compras")">          <i class="bi bi-truck"></i>          Compras       </a>
            <a href="/MetodosAplicacao/Index" class="sb-link @A("MetodosAplicacao")"> <i class="bi bi-tools"></i>          Métodos       </a>

            <div class="sb-section">Financeiro</div>
            <a href="/Despesas/Index"    class="sb-link @A("Despesas")">    <i class="bi bi-cash-stack"></i>      Despesas   </a>
            <a href="/Financeiro/Index"  class="sb-link @A("Financeiro")">  <i class="bi bi-graph-up-arrow"></i>  Financeiro </a>
            <a href="/Relatorios/Vendas" class="sb-link @A("Relatorios")">  <i class="bi bi-bar-chart-line"></i>  Relatórios </a>

            <div class="sb-section">Salão</div>
            <a href="/Servico/Index"      class="sb-link @A("Servico")">      <i class="bi bi-scissors"></i>      Serviços      </a>
            <a href="/Profissional/Index" class="sb-link @A("Profissional")"> <i class="bi bi-person-badge"></i>  Profissionais </a>

            <div class="sb-section">Sistema</div>
            <a href="/AdminUsuarios/Index" class="sb-link @A("AdminUsuarios")"> <i class="bi bi-shield-lock"></i> Usuários </a>
        }
    </nav>

    <div class="sb-footer">
        <div class="sb-avatar">@ini</div>
        <div style="overflow:hidden;flex:1;">
            <div class="sb-uname">@email</div>
            <div class="sb-urole">@(isAdmin ? "Administrador" : "Usuário")</div>
        </div>
    </div>
</aside>

<!-- CONTENT -->
<main class="content">
    @if (TempData["Msg"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show mb-3">
            <i class="bi bi-info-circle me-2"></i>@TempData["Msg"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3">
            <i class="bi bi-check-circle me-2"></i>@TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3">
            <i class="bi bi-exclamation-circle me-2"></i>@TempData["Erro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @RenderBody()
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const sidebar  = document.getElementById('sidebar');
    const overlay  = document.getElementById('sidebarOverlay');
    const btnMenu  = document.getElementById('btnMenu');
    const btnClose = document.getElementById('btnCloseSidebar');

    function abrirSidebar()  { sidebar.classList.add('open');    overlay.classList.add('active');    document.body.style.overflow = 'hidden'; }
    function fecharSidebar() { sidebar.classList.remove('open'); overlay.classList.remove('active'); document.body.style.overflow = ''; }

    btnMenu?.addEventListener('click', abrirSidebar);
    btnClose?.addEventListener('click', fecharSidebar);
    overlay?.addEventListener('click', fecharSidebar);

    // Fecha ao navegar pelo menu no mobile
    document.querySelectorAll('.sb-link').forEach(l => {
        l.addEventListener('click', () => { if (window.innerWidth <= 991) fecharSidebar(); });
    });

    window.addEventListener('resize', () => { if (window.innerWidth > 991) fecharSidebar(); });
</script>

@RenderSection("Scripts", false)
</body>
</html>
