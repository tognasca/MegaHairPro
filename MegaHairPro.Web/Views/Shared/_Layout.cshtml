<!DOCTYPE html>
<html lang="pt-br">
<head>

    <meta charset="utf-8" />
    <title>MegaHairPro Premium</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Mask -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.maskMoney/3.0.2/jquery.maskMoney.min.js"></script>


    <style>

        body {
            background: linear-gradient(135deg,#f6f9fc,#eef2f7);
            font-family: Segoe UI;
        }

        .categoria-badge {
            display: flex;
            align-items: center;
            gap: 8px;
        }


        .dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            display: inline-block;
        }

        /* SIDEBAR PREMIUM */

        .sidebar {
            width: 260px;
            min-height: 100vh;
            background: linear-gradient(180deg,#0f172a,#020617);
            color: #fff;
            position: fixed;
            transition: .3s;
            box-shadow: 4px 0 20px rgba(0,0,0,.1);
        }

            .sidebar a {
                color: #cbd5e1;
                padding: 12px 18px;
                border-radius: 8px;
                margin: 4px 10px;
                display: block;
                transition: .2s;
            }

                .sidebar a:hover {
                    background: #2563eb;
                    color: #fff;
                    transform: translateX(5px);
                }

            .sidebar .active {
                background: #2563eb;
                color: #fff;
            }


        /* LOGO */

        .sidebar-brand {
            text-align: center;
            padding: 25px;
            border-bottom: 1px solid rgba(255,255,255,.05);
        }

        .logo-img {
            width: 140px;
            margin-bottom: 10px;
        }

        .login-subtitle {
            font-size: 12px;
            color: #94a3b8;
        }


        /* CONTENT */

        .content {
            margin-left: 260px;
            padding: 30px;
            animation: fade .4s;
        }

        @@keyframes fade {
            from

        {
            opacity: 0;
            transform: translateY(10px)
        }

        to {
            opacity: 1
        }

        }

        .toast {
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,.2);
        }
        /* TOPBAR */

        .topbar {
            background: #fff;
            padding: 15px 25px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,.05);
            margin-bottom: 20px;
        }


        /* CARD PREMIUM */

        .card-premium {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 4px 20px rgba(0,0,0,.06);
            padding: 20px;
            transition: .3s;
        }

            .card-premium:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 30px rgba(0,0,0,.08);
            }


        /* BOTÕES */

        .btn {
            border-radius: 10px;
        }

        .btn-primary {
            background: #2563eb;
            border: none;
        }

            .btn-primary:hover {
                background: #1d4ed8;
            }


        /* TABLE PREMIUM */

        .table {
            border-radius: 12px;
            overflow: hidden;
        }

            .table thead {
                background: #0f172a;
                color: #fff;
            }

            .table tbody tr {
                transition: .2s;
            }

                .table tbody tr:hover {
                    background: #f1f5f9;
                    transform: scale(1.01);
                }


        /* STATUS BADGE */

        .badge {
            padding: 6px 10px;
            border-radius: 8px;
            font-size: 12px;
        }


        /* MOBILE */

        @@media(max - width:768px) {
            .sidebar

        {
            display: none;
        }

        .content {
            margin-left: 0;
        }

        }
    </style>

</head>

<body>


    <!-- SIDEBAR -->

    <div class="sidebar">

        <div class="sidebar-brand">

            <img src="~/Imagem/LogoMegaHairPro.png" class="logo-img" />

            <div class="login-subtitle">

                MegaHairPro Premium

            </div>

        </div>


        <a href="/Dashboard/index">

            <i class="bi bi-house"></i>

            Dashboard

        </a>


        <a href="/Produtos/Index"
           class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Produtos" ? "active" : "")">

            <i class="bi bi-box"></i>

            Produtos

        </a>


        <a href="/MetodosAplicacao/Index"
           class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "MetodosAplicacao" ? "active" : "")">

            <i class="bi bi-box"></i>

            Metodos

        </a>

        <a href="/Compras/Index"
           class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Compras" ? "active" : "")">

            <i class="bi bi-box"></i>

            Compras

        </a>


        <a href="/Despesas/Index"
           class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Despesas" ? "active" : "")">

            <i class="bi bi-cash"></i>

            Despesas

        </a>

        <a href="/Financeiro/Index"
           class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Financeiro" ? "active" : "")">

            <i class="bi bi-graph-up"></i>

            Financeiro

        </a>

        <a href="/Simulacao/Index"
           class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Simulacao" ? "active" : "")">

            <i class="bi bi-cash"></i>

            Simulacao

        </a>

        <a href="/Venda/Index">

            <i class="bi bi-bag"></i>

            Vendas

        </a>


        <a href="/Clientes/Index">

            <i class="bi bi-people"></i>

            Clientes

        </a>

        <a href="/Agendamento/Index"
           class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Agendamento" ? "active" : "")">

            <i class="bi bi-calendar-event"></i>

            Agenda

        </a>

        <a href="/Relatorios/Vendas"
           class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Relatorios" ? "active" : "")">

            <i class="bi bi-bar-chart"></i>

            Relatórios

        </a>


    </div>


    <!-- CONTENT -->

    <div class="content">


        <div class="topbar d-flex justify-content-between">


            <div>

                Sistema MegaHairPro

            </div>


            <div>

                Olá, @User.Identity.Name

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <button class="btn btn-sm btn-danger">

                        Sair

                    </button>

                </form>

            </div>


        </div>


        @RenderBody()


    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>


    @RenderSection("Scripts", false)


</body>

</html>