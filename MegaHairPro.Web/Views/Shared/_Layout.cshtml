<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>MegaHairPro</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- PWA -->
    <meta name="theme-color" content="#ff4d6d">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="manifest" href="/manifest.json">

    <!-- CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Mask -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.maskMoney/3.0.2/jquery.maskMoney.min.js"></script>

    <style>

        body {
            background-color: #f4f6f9;
        }

        /* SIDEBAR */
        .sidebar {
            width: 260px;
            min-height: 100vh;
            background-color: #000;
        }

            .sidebar a {
                color: #d1d5db;
                text-decoration: none;
            }

                .sidebar a:hover {
                    background-color: #374151;
                    color: #fff;
                }

            .sidebar .active {
                background-color: rgba(0,0,0,0.05);
                color: #fff;
            }

        /* FAIXA PRETA SUPERIOR */
        .sidebar-brand {
            background: #000;
            padding: 30px 20px;
            margin: -1rem -1rem 25px -1rem;
            text-align: center;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

            .sidebar-brand .logo-img {
                width: 150px;
                height: auto;
                margin-bottom: 12px;
            }

            /* PRATA */
            .sidebar-brand .login-subtitle {
                font-size: 0.9rem;
                font-weight: 500;
                letter-spacing: 1px;
                background: linear-gradient(90deg,#c0c0c0,#f5f5f5,#c0c0c0);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                margin-bottom: 4px;
            }

            .sidebar-brand .login-subtitle2 {
                color: #d1d5db;
                font-size: 0.85rem;
                letter-spacing: 0.5px;
            }

        /* CONTEÚDO */
        .content {
            padding: 25px;
        }

        /* CARD PADRÃO */
        .page-card {
            background: #fff;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }

        .page-title {
            font-size: 1.4rem;
            font-weight: 600;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* MOBILE */
       @@media (max-width:768px) {
            .content

        {
            padding-bottom: 90px;
        }

        .sidebar {
            display: none;
        }

        }

        /* MENU MOBILE */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            width: 100%;
            background: rgba(0,0,0,0.05);
            display: flex;
            justify-content: space-around;
            padding: 10px 0;
            z-index: 999;
        }

            .bottom-nav .nav-item {
                color: #d1d5db;
                text-decoration: none;
                font-size: 0.75rem;
                display: flex;
                flex-direction: column;
                align-items: center;
            }

                .bottom-nav .nav-item i {
                    font-size: 1.2rem;
                }

    </style>
</head>

<body>

    <!-- SERVICE WORKER -->
    <script>
        if ("serviceWorker" in navigator) {
            navigator.serviceWorker.register("/service-worker.js");
        }
    </script>

    <div class="d-flex">

        <!-- SIDEBAR -->
        <aside class="sidebar p-3 d-none d-md-block">

            <!-- FAIXA PRETA COM LOGO -->
            <div class="sidebar-brand">

                <img src="~/Imagem/LogoMegaHairPro.png" class="logo-img" />

                <div class="login-subtitle">
                    By Tatiane Tognasca
                </div>
            </div>

            <!-- MENU -->
            <nav class="nav flex-column gap-1">

                <span class="text-uppercase text-secondary small px-2">Cadastros</span>

                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Produtos" ? "active" : "")"
                   href="/Produtos/Index">
                    <i class="bi bi-box-seam"></i> Produtos
                </a>

                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Fornecedores" ? "active" : "")"
                   href="/Fornecedores/Index">
                    <i class="bi bi-truck"></i> Fornecedores
                </a>

                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Clientes" ? "active" : "")"
                   href="/Clientes/Index">
                    <i class="bi bi-people"></i> Clientes
                </a>

                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "MetodosAplicacao" ? "active" : "")"
                   href="/MetodosAplicacao/Index">
                    <i class="bi bi-scissors"></i> Métodos
                </a>

                <span class="text-uppercase text-secondary small px-2 mt-3">Movimentação</span>

                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Compras" ? "active" : "")"
                   href="/Compras/Index">
                    <i class="bi bi-cart-plus"></i> Compras
                </a>

                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Despesas" ? "active" : "")"
                   href="/Despesas/Index">
                    <i class="bi bi-cash-coin"></i> Despesas
                </a>

                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Simulacao" ? "active" : "")"
                   href="/Simulacao/Index">
                    <i class="bi bi-calculator"></i> Simulação
                </a>

                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Venda" ? "active" : "")"
                   href="/Venda/Index">
                    <i class="bi bi-bag-check"></i> Vendas
                </a>

                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Comissao" ? "active" : "")"
                   href="/Comissao/Index">
                    <i class="bi bi-wallet2"></i> Comissões
                </a>

                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminUsuarios" ? "active" : "")"
                   href="/AdminUsuarios/Index">
                    <i class="bi bi-person-gear"></i> Usuários
                </a>

            </nav>

        </aside>

        <!-- CONTEÚDO -->
        <div class="flex-grow-1">

            <!-- TOPBAR -->
            <nav class="navbar navbar-light bg-white border-bottom px-4 d-flex justify-content-between">

                <span class="navbar-text fw-semibold">
                    Sistema de Gestão MegaHairPro
                </span>

                <div class="d-flex align-items-center gap-3">

                    <span class="text-muted">
                        Olá, @User.Identity.Name 👋
                    </span>

                    @if (User.Identity.IsAuthenticated)
                    {
                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-box-arrow-right"></i> Sair
                            </button>
                        </form>
                    }

                </div>

            </nav>

            <!-- CORPO -->
            <main class="content">
                @RenderBody()
            </main>

        </div>

    </div>

    <!-- MENU MOBILE -->
    <nav class="bottom-nav d-md-none">

        <a href="/Dashboard" class="nav-item">
            <i class="bi bi-house-fill"></i>
            <span>Home</span>
        </a>

        <a href="/Simulacao/Index" class="nav-item">
            <i class="bi bi-plus-circle-fill"></i>
            <span>Simular</span>
        </a>

        <a href="/Venda/Index" class="nav-item">
            <i class="bi bi-bag-check-fill"></i>
            <span>Vendas</span>
        </a>

        <a href="/Comissao/Index" class="nav-item">
            <i class="bi bi-wallet-fill"></i>
            <span>Comissão</span>
        </a>

        <a href="/Produtos/Index" class="nav-item">
            <i class="bi bi-box-seam-fill"></i>
            <span>Estoque</span>
        </a>

    </nav>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
