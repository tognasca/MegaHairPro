@model MegaHairPro.Web.Models.SimulacaoVenda
@{
    Layout = null;
    decimal precoFinal     = Model.PrecoVenda ?? 0;
    decimal custoCabelo    = Model.CustoCabelo ?? 0;
    decimal lucroCabelo    = Model.ValorLucroCabelo ?? 0;
    decimal precoCabelo    = custoCabelo + lucroCabelo;
    decimal confeccao      = Model.ValorTotalConfeccao ?? 0;
    decimal desconto       = Model.ValorDesconto ?? 0;
    decimal margem         = Model.MargemPercentual ?? 0;
    bool    temDesconto    = desconto > 0;
    bool    temConfeccao   = confeccao > 0;
    var     validade       = Model.DataValidadePix != default
                                ? Model.DataValidadePix
                                : DateTime.Now.AddDays(7);
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f0f0f0;
            padding: 30px;
            color: #1a1a1a;
        }

        .page {
            background: #fff;
            max-width: 720px;
            margin: 0 auto;
            border-radius: 12px;
            overflow: hidden;
            position: relative;
            box-shadow: 0 4px 24px rgba(0,0,0,.12);
        }

        /* WATERMARK */
        .watermark {
            position: fixed;
            top: 38%;
            left: 5%;
            font-size: 110px;
            font-weight: 900;
            letter-spacing: 12px;
            color: rgba(0,0,0,.035);
            transform: rotate(-32deg);
            pointer-events: none;
            user-select: none;
            z-index: 0;
        }

        /* HEADER */
        .header { background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 60%, #1d4ed8 100%); position: relative; overflow: hidden; }
        .header-inner { display: flex; align-items: center; justify-content: space-between; padding: 22px 32px; position: relative; z-index: 1; }
        .header-logo-wrap { background: rgba(255,255,255,.12); border-radius: 10px; padding: 8px 14px; border: 1px solid rgba(255,255,255,.2); }
        .header-logo { width: 90px; display: block; }
        .header-info { text-align: right; }
        .header-title { font-size: 24px; font-weight: 800; color: #fff; letter-spacing: -.3px; }
        .header-sub { font-size: 12px; color: #93c5fd; margin-top: 3px; }
        .header-doc { display: inline-block; font-size: 10px; color: #bfdbfe; background: rgba(255,255,255,.1); border-radius: 20px; padding: 3px 10px; margin-top: 7px; border: 1px solid rgba(255,255,255,.15); }
        .header-bar { height: 3px; background: linear-gradient(90deg, #f59e0b, #fbbf24, #f59e0b); }

        /* BODY */
        .body { padding: 28px 32px; }

        /* CLIENTE */
        .cliente-box {
            background: #f8fafc;
            border-left: 4px solid #2563eb;
            border-radius: 8px;
            padding: 16px 18px;
            margin-bottom: 22px;
        }
        .cliente-box h4 { font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: #64748b; margin-bottom: 10px; }
        .cliente-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
        .cliente-item label { font-size: 11px; color: #94a3b8; display: block; }
        .cliente-item span { font-size: 13.5px; font-weight: 600; color: #0f172a; }

        /* SEÇÃO */
        .section-title {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #64748b;
            font-weight: 700;
            margin: 20px 0 10px;
            padding-bottom: 6px;
            border-bottom: 1px solid #e2e8f0;
        }

        /* LINHA DE VALOR */
        .linha {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 7px 0;
            border-bottom: 1px dashed #f1f5f9;
            font-size: 13.5px;
        }
        .linha:last-child { border-bottom: none; }
        .linha .label { color: #475569; }
        .linha .valor { font-weight: 600; color: #0f172a; }
        .linha.destaque { background: #f0f9ff; border-radius: 6px; padding: 8px 10px; margin: 4px 0; border-bottom: none; }
        .linha.desconto .valor { color: #dc2626; }
        .linha.total-row { font-size: 15px; font-weight: 700; }

        /* TOTAL BOX */
        .total-box {
            background: linear-gradient(90deg, #92400e, #d97706, #f59e0b, #d97706, #92400e);
            padding: 20px 24px;
            border-radius: 10px;
            margin: 22px 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .total-box .total-label { color: #fff8e7; font-size: 14px; font-weight: 600; }
        .total-box .total-valor { color: #fff; font-size: 28px; font-weight: 900; }

        /* PAGAMENTO */
        .pagamento-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 8px;
        }
        .pgto-card {
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 12px 14px;
        }
        .pgto-card .pgto-icon { font-size: 18px; margin-bottom: 4px; }
        .pgto-card .pgto-title { font-size: 12px; font-weight: 700; color: #0f172a; }
        .pgto-card .pgto-desc { font-size: 11px; color: #64748b; margin-top: 2px; }

        /* VALIDADE */
        .validade-box {
            background: #fefce8;
            border: 1px solid #fde047;
            border-radius: 8px;
            padding: 10px 14px;
            margin-top: 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .validade-box span { font-size: 12px; color: #854d0e; }
        .validade-box strong { font-size: 13px; color: #713f12; }

        /* MARGEM BADGE */
        .margem-badge {
            display: inline-block;
            background: @(margem >= 20 ? "#dcfce7" : margem >= 10 ? "#fef9c3" : "#fee2e2");
            color: @(margem >= 20 ? "#15803d" : margem >= 10 ? "#854d0e" : "#dc2626");
            border-radius: 20px;
            padding: 3px 10px;
            font-size: 12px;
            font-weight: 700;
        }

        /* PIX */
        .pix-box { text-align: center; margin-top: 16px; }
        .pix-box img { width: 140px; }
        .pix-box p { font-size: 12px; color: #64748b; margin-top: 6px; }

        /* FOOTER */
        .footer {
            background: #0f172a;
            padding: 16px 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 24px;
        }
        .footer-left { color: #94a3b8; font-size: 11px; line-height: 1.7; }
        .footer-right { text-align: right; color: #64748b; font-size: 10px; }
        .footer-brand { color: #f8fafc; font-weight: 700; font-size: 13px; }
    </style>
</head>
<body>

    <div class="watermark">SIMULAÇÃO</div>

    <div class="page">

        <!-- HEADER -->
        <div class="header">
            <div class="header-inner">
                <div class="header-logo-wrap">
                    <img src="@Model.LogoCaminho" class="header-logo" />
                </div>
                <div class="header-info">
                    <div class="header-title">Simulação de Venda</div>
                    <div class="header-sub">Mega Hair Pro • Tatiane Tognasca</div>
                    <div class="header-doc">📅 Emitido em @DateTime.Now.ToString("dd/MM/yyyy")</div>
                </div>
            </div>
            <div class="header-bar"></div>
        </div>

        <div class="body">

            <!-- CLIENTE -->
            <div class="cliente-box">
                <h4>Dados do Cliente</h4>
                <div class="cliente-grid">
                    <div class="cliente-item">
                        <label>Cliente</label>
                        <span>@Model.ClienteNome</span>
                    </div>
                    <div class="cliente-item">
                        <label>Produto</label>
                        <span>@Model.ProdutoNome</span>
                    </div>
                    <div class="cliente-item">
                        <label>Quantidade</label>
                        <span>@Model.QuantidadeGramas.ToString("N0") g</span>
                    </div>
                    <div class="cliente-item">
                        <label>Método de Aplicação</label>
                        <span>@(string.IsNullOrEmpty(Model.MetodoNome) ? "—" : Model.MetodoNome)</span>
                    </div>
                </div>
            </div>

            <!-- COMPOSIÇÃO DO PREÇO -->
            <div class="section-title">Composição do Preço</div>

            <div class="linha destaque">
                <span class="label">Cabelo (@Model.QuantidadeGramas.ToString("N0")g)</span>
                <span class="valor">R$ @precoCabelo.ToString("N2")</span>
            </div>

            @if (temConfeccao)
            {
                <div class="linha">
                    <span class="label">Confecção — @Model.MetodoNome</span>
                    <span class="valor">R$ @confeccao.ToString("N2")</span>
                </div>
            }

            @if (temDesconto)
            {
                <div class="linha">
                    <span class="label">Subtotal</span>
                    <span class="valor">R$ @((Model.PrecoVendaOriginal ?? 0).ToString("N2"))</span>
                </div>
                <div class="linha desconto">
                    <span class="label">Desconto (@Model.PercentualDesconto?.ToString("N0")%)</span>
                    <span class="valor">− R$ @desconto.ToString("N2")</span>
                </div>
            }

            <!-- TOTAL -->
            <div class="total-box">
                <span class="total-label">💰 Valor da Venda</span>
                <span class="total-valor">R$ @precoFinal.ToString("N2")</span>
            </div>

            <!-- CONDIÇÕES DE PAGAMENTO -->
            <div class="section-title">Condições de Pagamento</div>
            <div class="pagamento-grid">
                <div class="pgto-card">
                    <div class="pgto-icon">💵</div>
                    <div class="pgto-title">À Vista</div>
                    <div class="pgto-desc">Dinheiro, PIX ou débito<br/>Sem acréscimos</div>
                </div>
                <div class="pgto-card">
                    <div class="pgto-icon">💳</div>
                    <div class="pgto-title">Crédito Parcelado</div>
                    <div class="pgto-desc">Parcelamento disponível<br/>Sujeito a juros da maquininha</div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.QrCodePixBase64))
            {
                <div class="pix-box">
                    <p style="font-weight:600; color:#0f172a; margin-bottom:6px;">Pagamento via PIX</p>
                    <img src="data:image/png;base64,@Model.QrCodePixBase64" />
                    <p>Escaneie o QR Code para pagamento</p>
                </div>
            }

            <!-- VALIDADE -->
            <div class="validade-box">
                <span>⏳ Proposta válida até</span>
                <strong>@validade.ToString("dd/MM/yyyy")</strong>
            </div>

        </div>

        <!-- FOOTER -->
        <div class="footer">
            <div class="footer-left">
                <div class="footer-brand">Mega Hair Pro</div>
                <div>Tatiane Tognasca</div>
                <div>Rua das Manacás, 340, Sala 1</div>
                <div>📞 (11) 93052-8032</div>
            </div>
            <div class="footer-right">
                Documento informativo • Não fiscal<br/>
                Valores sujeitos a alteração<br/>
                Gerado em @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>

    </div>

</body>
</html>
