@model MegaHairPro.Web.Models.SimulacaoVenda

<tr id="row-@Model.Id"
    data-preco="@(Model.PrecoVenda?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")"
    data-custo="@(Model.CustoTotal?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")">

    <td style="font-weight:600;">@Model.ClienteNome</td>
    <td style="color:#64748b;font-size:12px;">@Model.ProdutoNome</td>
    <td>@Model.QuantidadeGramas.ToString("N0") g</td>
    <td>R$ @Model.CustoTotal?.ToString("N2")</td>
    <td style="font-weight:600;">R$ @Model.PrecoVenda?.ToString("N2")</td>
    <td>
        @if ((Model.ValorDesconto ?? 0) > 0)
        {
            <span style="color:#dc2626;font-size:12px;font-weight:600;">
                −@Model.PercentualDesconto?.ToString("N0")% / R$ @Model.ValorDesconto?.ToString("N2")
            </span>
        }
        else
        {
            <span style="color:#94a3b8;font-size:12px;">—</span>
        }
    </td>
    <td>
        @{
            decimal? margem = Model.PrecoVenda > 0 ? (Model.LucroTotal / Model.PrecoVenda) * 100 : 0;
            string badgeClass = Model.LucroTotal > 200 ? "badge bg-success-soft" : Model.LucroTotal > 0 ? "badge bg-warning-soft" : "badge bg-danger-soft";
        }
        <span class="@badgeClass">R$ @Model.LucroTotal?.ToString("N2")</span>
        <div style="font-size:10px;color:#94a3b8;margin-top:2px;">Margem: @margem?.ToString("N1")%</div>
    </td>
    <td style="color:#64748b;font-size:12px;">@Model.DataCadastro.ToString("dd/MM/yyyy")</td>
    <td>
        <div class="d-flex gap-1 flex-wrap">
            <button class="btn-act btn-act-red" onclick="excluirSimulacao(@Model.Id)">Excluir</button>
            <button class="btn-act btn-act-green" onclick="confirmarVenda(@Model.Id)">Confirmar</button>
            <a class="btn-act btn-act-dark" target="_blank" href="@Url.Action("GerarPdf","Simulacao", new { id = Model.Id })">PDF</a>
            <a class="btn-act btn-act-blue" target="_blank" href="@Url.Action("Imprimir","Simulacao", new { id = Model.Id })">Imprimir</a>
        </div>
    </td>
</tr>
