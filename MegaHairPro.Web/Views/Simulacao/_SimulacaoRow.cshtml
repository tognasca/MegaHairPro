@model MegaHairPro.Web.Models.SimulacaoVenda

<tr id="row-@Model.Id"
    data-cliente="@Model.ClienteNome"
    data-produto="@Model.ProdutoNome"
    data-qtd="@Model.QuantidadeGramas"
    data-preco="@Model.PrecoVenda"
    data-precodesconto="@Model.ValorDesconto"
    data-custo="@Model.CustoTotal">

    <!-- ✅ Cliente -->
    <td>@Model.ClienteNome</td>
    <!-- ✅ Produto -->
    <td>@Model.ProdutoNome</td>
    <!-- ✅ Quantidade Vendida -->
    <td>@Model.QuantidadeGramas.ToString("N0")</td>
    <!-- ✅ Custo -->
    <td>R$ @Model.CustoTotal?.ToString("N2")</td>
    <!-- ✅ Preço -->
    <td>R$ @Model.PrecoVenda?.ToString("N2")</td>

    <!-- Preco desconto/%-->
    <td class="text-warning fw-bold">
        R$ @Model.ValorDesconto?.ToString("N2")
        <small class="text-muted">
            (@((Model.PercentualDesconto ?? 0).ToString("N0"))%)
        </small>
    </td>
    <!-- ✅ Lucro + Margem -->
    <td>
        @{
            decimal? margem = 0;

            if (Model.PrecoVenda > 0)
            {
                margem = (Model.LucroTotal / Model.PrecoVenda) * 100;
            }
        }

        @if (Model.LucroTotal > 200)
        {
            <span class="badge bg-success fs-6">
                ✅ R$ @Model.LucroTotal?.ToString("N2")
            </span>
            <br />
            <small class="text-success">
                Margem: @margem?.ToString("N1")%
            </small>
        }
        else if (Model.LucroTotal > 0)
        {
            <span class="badge bg-warning text-dark fs-6">
                ⚠️ R$ @Model.LucroTotal?.ToString("N2")
            </span>
            <br />
            <small class="text-warning">
                Margem: @margem?.ToString("N1")%
            </small>
        }
        else
        {
            <span class="badge bg-danger fs-6">
                ❌ R$ @Model.LucroTotal?.ToString("N2")
            </span>
            <br />
            <small class="text-danger">
                Margem: @margem?.ToString("N1")%
            </small>
        }
    </td>

    <!-- ✅ Data -->
    <td>@Model.DataCadastro.ToShortDateString()</td>

    <!-- ✅ Ações -->
    <td>
        <button class="btn btn-danger btn-sm"
                onclick="excluirSimulacao(@Model.Id)">
            ❌ Excluir
        </button>
        <button class="btn btn-primary btn-sm"
                onclick="confirmarVenda(@Model.Id)">
            ✅ Confirmar Venda
        </button>
        @* <a class="btn btn-secondary btn-sm"
           target="_blank"
           href="@Url.Action("GerarPdf","Simulacao",
                        new { id = Model.Id })">
            🖨️ Imprimir
        </a> *@
        <a class="btn btn-dark btn-sm"
           target="_blank"
           href="@Url.Action("GerarPdf","Simulacao",
                    new { id = Model.Id })">
            🧾 PDF
        </a>

        <a class="btn btn-secondary btn-sm"
           target="_blank"
           href="@Url.Action(
                   "GerarPdf",
                   "Simulacao",
                   new { id = Model.Id })">

            🖨️ Imprimir

        </a>
    </td>
</tr>
