@model IEnumerable<MegaHairPro.Web.Models.Venda>

@{
    ViewData["Title"] = "Vendas Realizadas";
}

<div class="page-header">
    <div class="page-title">Vendas Realizadas</div>
    <div class="page-sub">Histórico e resumo de vendas por período</div>
</div>

<!-- FILTRO -->
<div class="section-card">
    <div class="section-label">Filtrar período</div>
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-2">
            <label class="form-label">Mês</label>
            <input type="number" name="mes" value="@ViewBag.Mes" class="form-control" min="1" max="12" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Ano</label>
            <input type="number" name="ano" value="@ViewBag.Ano" class="form-control" />
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary w-100">Filtrar</button>
        </div>
    </form>
</div>

<!-- CARDS RESUMO -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div style="background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:16px 20px;">
            <div style="font-size:11px;color:#94a3b8;font-weight:700;text-transform:uppercase;letter-spacing:1px;">Total Vendido</div>
            <div style="font-size:24px;font-weight:700;color:#2563eb;margin-top:4px;">R$ @ViewBag.TotalVendas.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-4">
        <div style="background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:16px 20px;">
            <div style="font-size:11px;color:#94a3b8;font-weight:700;text-transform:uppercase;letter-spacing:1px;">Lucro Total</div>
            <div style="font-size:24px;font-weight:700;color:#16a34a;margin-top:4px;">R$ @ViewBag.TotalLucro.ToString("N2")</div>
        </div>
    </div>
    <div class="col-md-4">
        <div style="background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:16px 20px;">
            <div style="font-size:11px;color:#94a3b8;font-weight:700;text-transform:uppercase;letter-spacing:1px;">Comissões Pagas</div>
            <div style="font-size:24px;font-weight:700;color:#dc2626;margin-top:4px;">R$ @ViewBag.TotalComissoes.ToString("N2")</div>
        </div>
    </div>
</div>

<!-- TABELA -->
<div class="table-card">
    <div class="table-card-header">
        <span class="table-card-title">Vendas do período</span>
        <span class="table-count">@Model.Count() registros</span>
    </div>
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Produto</th>
                    <th class="text-end">Qtd</th>
                    <th class="text-end">Preço</th>
                    <th class="text-end">Lucro</th>
                    <th class="text-end">Comissões</th>
                    <th>Data</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model)
                {
                    <tr>
                        <td style="font-weight:600;">@v.ClienteNome</td>
                        <td style="font-size:12px;color:#64748b;">@v.ProdutoNome</td>
                        <td class="text-end" style="font-size:13px;">@v.QuantidadeGramas g</td>
                        <td class="text-end" style="font-weight:600;color:#2563eb;">R$ @v.PrecoVenda?.ToString("N2")</td>
                        <td class="text-end" style="font-weight:600;color:#16a34a;">R$ @v.LucroTotal?.ToString("N2")</td>
                        <td class="text-end" style="color:#dc2626;font-size:13px;">
                            R$ @((v.ValorComissaoVendedora + v.ValorComissaoCabeleireira).ToString("N2"))
                        </td>
                        <td style="font-size:12px;color:#64748b;">@v.DataVenda.ToString("dd/MM/yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
