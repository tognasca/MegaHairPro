@model IEnumerable<MegaHairPro.Web.Models.Venda>

@{
    ViewData["Title"] = "Vendas Realizadas";
}

<h2>📌 Vendas Realizadas</h2>
<br />

<!-- ✅ FILTRO MÊS -->
<form method="get" class="row g-3 mb-4">

    <div class="col-md-2">
        <label>Mês</label>
        <input type="number" name="mes"
               value="@ViewBag.Mes"
               class="form-control" min="1" max="12" />
    </div>

    <div class="col-md-2">
        <label>Ano</label>
        <input type="number" name="ano"
               value="@ViewBag.Ano"
               class="form-control" />
    </div>

    <div class="col-md-3 align-self-end">
        <button class="btn btn-primary w-100">
            🔍 Filtrar
        </button>
    </div>

</form>

<hr />

<!-- ✅ RESUMO DO MÊS -->
<div class="row mb-4">

    <div class="col-md-4">
        <div class="card shadow-sm p-3 rounded-4">
            <h5 class="text-muted">Total Vendido</h5>
            <h3 class="text-primary fw-bold">
                R$ @ViewBag.TotalVendas.ToString("N2")
            </h3>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm p-3 rounded-4">
            <h5 class="text-muted">Lucro Total</h5>
            <h3 class="text-success fw-bold">
                R$ @ViewBag.TotalLucro.ToString("N2")
            </h3>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm p-3 rounded-4">
            <h5 class="text-muted">Comissões Pagas</h5>
            <h3 class="text-danger fw-bold">
                R$ @ViewBag.TotalComissoes.ToString("N2")
            </h3>
        </div>
    </div>

</div>

<hr />

<!-- ✅ GRID -->
<table class="table table-bordered table-striped align-middle">
    <thead class="table-light">
        <tr>
            <th>Cliente</th>
            <th>Produto</th>
            <th>Qtd (g)</th>
            <th>Preço</th>
            <th>Lucro</th>
            <th>Comissões</th>
            <th>Data</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var v in Model)
        {
            <tr>
                <td>@v.ClienteNome</td>
                <td>@v.ProdutoNome</td>
                <td>@v.QuantidadeGramas</td>

                <td class="fw-bold text-primary">
                    R$ @v.PrecoVenda.ToString("N2")
                </td>

                <td class="fw-bold text-success">
                    R$ @v.LucroTotal.ToString("N2")
                </td>

                <td class="text-danger">
                    R$ @(v.ValorComissaoVendedora + v.ValorComissaoCabeleireira).ToString("N2")
                </td>

                <td>@v.DataVenda.ToShortDateString()</td>
            </tr>
        }
    </tbody>
</table>
